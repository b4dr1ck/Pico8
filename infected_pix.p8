pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- infected pixels
-- BY BADRICK 2026

-----------------------------------

-- game loop
function _init() 
 sfx(6)
 
 poke(0x5f2d,0x1) -- active mouse
	poke(0x5f34,0x2) -- inverted draw operations
	 
	deathtextmap={
	"you are dead",
	"afk 4 evr",
	"fucked up, i guess",
	"you life ends here",
	"no more sorrows",
	"you are elimnated",
	"that's it",
	"say good bye"
	}
 mapbounds_x=128
 mapbounds_y=128
 game_timer=0
 killcounter=0
 player={
  deathtext=deathtextmap[randi(#deathtextmap)],
  timer={invincible=60,spdboost=300},
  hp=5,
  name="player",
  invincible=false,
  x=60,
  y=60,
  w=8,
  h=8,
  img=4,
  spd=1,
  fliph=false,
  state="idle",
  launchfrq=30,
  launchspd=2,
  projectiles=1,
  }
  
 state_frames={
 	idle={4,5,20},
 	walk={1,4,10},
 	shoot={6,6,10},
 }

 projectiles={}
 rain={}
 zombies={}
 sprites={}
 blood={}
 runningblood={}
 particles={}
 items={}
  
 aimline={
	 visible=false,
  x1=0,
  y1=0,
  x2=0,
  y2=0,
 }
 
 spawntimer=300
 spawnpoints={}
 
 -- set spawnpoints
 for x=1,31 do
  for y=1,31 do
   if fget(mget(x,y),1) do
    add(spawnpoints,{x=x*8,y=y*8})	
   end
  end
 end
 
 add(sprites,player)

end

function _update60()

 game_timer+=1

 -- update camera
 if player.invincible then
  -- shake camera effect
	 cam_x = mid(0, player.x - 64, mapbounds_x) + randi(5)-2
	 cam_y = mid(0, player.y - 64, mapbounds_y) + randi(5)-2
 else
	 cam_x = mid(0, player.x - 64, mapbounds_x) 
	 cam_y = mid(0, player.y - 64, mapbounds_y)
	end
	
 -- enemy spawner
 if game_timer % spawntimer == 0 and
    #zombies <= 50 and
    player.state != "dead"    
 then

  sfx(3)
   
  local spawnpoint = spawnpoints[randi(#spawnpoints)]  
  
  add(zombies,new_zombie(spawnpoint))
 	add(sprites,zombies[#zombies])
 	
 	spawntimer=randi(100) + 200
 end
 
 -- capture mouse input
 mousex=stat(32) + cam_x
 mousey=stat(33) + cam_y
 mouseb=stat(34)
 
 local mouse_angle = atan2(mousex-player.x,mousey-player.y)
 local dx=0
 local dy=0
 
 -- capture keyboard input
 if btn(⬅️) then dx=-1 end 
 if btn(➡️) then dx=1 end 
 if btn(⬆️) then dy=-1 end 
 if btn(⬇️) then dy=1 end 
 
 -- players death
 if player.state == "dead" then
  player.img = -1
	 if game_timer % 60 == 0 then
	  local x=randi(127)
	  if #runningblood < 100 then
		  add(runningblood,new_runningblood(x,0))
	  end
	 end
	 
	 for b in all(runningblood) do
	  if b.length < 127 then
		  b.length+=b.spd
		 end
	 end
	 
	else
	
	 -- speed boost
	 if player.spd > 1 and
	    player.timer.spdboost > 0  
	 then
	 	player.timer.spdboost-=1 
	 end
	 
	 if player.timer.spdboost == 0 then
	  player.spd=1
	  player.timer.spdboost=300 
	 end
	 
	 -- player movement
	 local old_x=player.x
	 player.x+=dx*player.spd
	 
	 if collide(player.x,player.y,2)
	 then	    
			player.x = old_x    
	 end
	 
	 local old_y=player.y
	 player.y+=dy*player.spd
	 
	 if collide(player.x,player.y,2)
	 then
			player.y = old_y    
	 end
	
	 -- player gets hit by zombie
	 for z in all(zombies) do
	  if aabb(player,z,0) then
	   if not player.invincible then
	   	player.hp -= 1
	   	sfx(2)
					add(blood,create_blood(player.x,player.y))

					if player.hp <= 0 then
	 	  	particles = blood_explosion(player.x+4,player.y+4)
	 	  	for i=1,5 do
		 	  	add(blood,create_blood(player.x,player.y))
		 	  end
		 	  sfx(7)
					 player.state = "dead"
					end
	   end
				player.invincible=true
	  end
	 end
	
	 -- aim line (gun)
		aimline.x1=player.x+4
		aimline.y1=player.y+4
		aimline.x2=player.x+4+cos(mouse_angle)*6
		aimline.y2=player.y+4+sin(mouse_angle)*6
	
	 -- player animations
	 if player.state != "dead" then
		 if dx != 0 or dy != 0 then
		  player.state="walk"
		 else 
		  if (mouseb == 1) then
		  	player.state="shoot"
		  else
			 	player.state="idle"
		 	end
		 end
		 
		 if dx < 0 then
				player.fliph=true
			elseif dx > 0 then
				player.fliph=false
		 end
		 
		 player.img = animate(
		 														game_timer,
		 														player.img,
		 														state_frames[player.state][1],
		 														state_frames[player.state][2],
		 														state_frames[player.state][3],
		 														false)
  end
	end
	 
 -- enemies
 for z in all(zombies) do
  if z.state == "walk" then
	  if z.hp <= 0 then
	   sfx(5)
	  	particles = blood_explosion(z.x+4,z.y+4)
    
    killcounter+=1
    
    -- drop items
    local itemimg=({128,129,130,131})[randi(4)]
    
	  	if randi(z.dropchance) == z.dropchance then
     add(items,new_item(itemimg,z.x,z.y))
	  	end
	  	
	   del(zombies,z)
	   del(sprites,z)
	  end
	 
	  -- movement
	  z.old_x = z.x
	  z.old_y = z.y
	  
	  if player.state != "dead" then
	   z.ang = atan2(player.x-z.x,player.y-z.y) 
		  
		  -- collision with player or obstacle
		  z.x += cos(z.ang) * z.spd
			 if aabb(z,player,2) or
			    collide(z.x,z.y,2)
			 then	    
					z.x = z.old_x    
			 end 
			 
			 z.y += sin(z.ang) * z.spd
			 if aabb(z,player,2) or
			    collide(z.x,z.y,2)
			 then	    
					z.y = z.old_y    
			 end
		 end
		 
			-- if enemy collides another enemy
			for z2 in all(zombies) do
				if aabb(z,z2,2) and
					  z2 != z
			 then
					z.x = z.old_x
					z.y = z.old_y
				end
			end
		 
		 -- animations
	  if (player.x-z.x < 0) then
	   z.fliph=true
	  else
	   z.fliph=false
	  end
	  
	  z.img = animate(
												game_timer,
												z.img,
												z.img_start,
												z.img_end,
												20,
												false)
  end
 end
 
 -- create rain
 if game_timer % 10 == 0 then
   local amount=randi(32)
   
 	 for x=0,amount do
		 	add(rain,
		 						new_rain(
		 						 randi(128)+cam_x,
		 						 randi(12),
		 						 5
		 						 )
		 					)	
		 end
 end
 
 -- create projectiles 
 if (mouseb == 1 and player.state != "dead") then
  player.state="shoot"
  aimline.visible=true
  
  if game_timer % player.launchfrq == 0 then
   local spread_angle=0.04
   
   -- create one or multiple p
   for p=1,player.projectiles do
    local angle_offset=(p-(player.projectiles+1)/2)*spread_angle
    add(projectiles,
     new_projectile(
      player.x+4,
      player.y+4,
      player.launchspd,
      mouse_angle+angle_offset,
      9)
    )
   end
	 		sfx(0)
	 	end
	else
  aimline.visible=false
 end

 -- items
 for i in all(items) do
 
  -- collisions
  if aabb(player,i,2) then
   sfx(4)
   
   -- medipacks
   if i.img == 128 then
    player.hp=min(10,player.hp+1)
   end
   
   -- energy drink
   if i.img == 129 then
    player.spd=min(2,player.spd+1)
   end
   
   -- launchfrq down
   if i.img == 130 then
    player.launchfrq=max(5,player.launchfrq-5)
   end
   
   -- projectiles up
   if i.img == 131 then
    player.projectiles=min(6,player.projectiles+1)
   end
   
   del(items,i)
  end
  i.y = sine_wave(i.x,i.y,0.5,0.05)
    						
 end

 -- update rain
 for r in all(rain) do
  r.y+=r.spd
  if leave_area(r.x,r.y,mapbounds_x,mapbounds_y)  
  then 
   del(rain,r)    
  end
 end
  
 -- update projectiles
 for p in all(projectiles) do
  p.x += cos(p.ang) * p.spd
  p.y += sin(p.ang) * p.spd
  
  if leave_area(p.x,p.y,mapbounds_x,mapbounds_y)  
  then 
   del(projectiles,p)    
  end 
  
  -- projectile hits zombie
  for z in all(zombies) do
	  if aabb(p,z,0) then

	  	z.state = "hit"	  
	  	z.hp -= 1
	  	
	  	sfx(1)
	  		
	  	del(projectiles,p)
	  	
	  	particles = blood_explosion(z.x+4,z.y+4)
    
    for b=0,3 do
		  	add(blood,create_blood(z.x,z.y))
		  end
	  end
  end
 end
 
 -- update particles
 for p in all(particles) do
  p.yspd += min(3,p.grav)
  p.x += p.xspd
  p.y += p.yspd
  
		if leave_area(p.x,p.y,mapbounds_x,mapbounds_y)  then
			del(particles,p)
		end
 end
  
 -- reset game-timer
 if game_timer > 1000 then
  game_timer=0
 end
end

--------------------------------------
function _draw()
 cls(1)

 -- set camera
 camera(cam_x, cam_y)
 
 -- map
 map(0,0)
 
 -- blood
 for b in all(blood) do
  circfill(b.x,b.y,b.r,8)
  b.ttl-=1
  if b.ttl <= 0 then
  	del(blood,b)
  end
 end
 
 -- items
 for i in all(items) do
  spr(i.img,i.x,i.y)
 end
 
 -- sprites
 isorty(sprites)
 for s in all(sprites) do
  
  -- handle zombies
  if s.name == "zombie" then
   -- recolor 
   if s.col > 0 then
	  	pal(7,s.col)
	  end
	  if s.col2 > 0 then
		  pal(1,s.col2)
		 end
	  
	  -- set color to white if hit
	  if s.state == "hit" then
	   s.timer.hit -= 1
	   for c=1,16 do
		  	pal(c,7)
	  	end
	  	
		  -- reset zombie state
			 if s.timer.hit == 0 then
			  s.state = "walk"
			  s.timer.hit = 15
			 end
	  end
	 end
	 
	 -- handle player
	 if s.name == "player" then
	  if s.invincible then
		  s.timer.invincible-=1
	   for c=1,16 do
		  	pal(c,7)
	  	end
	  		  	
	  	if s.timer.invincible == 0 then
	  		s.invincible = false
	  		s.timer.invincible=60
	  	end  	
	  end
	 end
	 	 
	 -- render player/zombie-sprites
 	spr(s.img,s.x,s.y,1,1,s.fliph)
 	
 	pal()
 end
 
 -- particles
 for p in all(particles) do
  circfill(p.x,p.y,p.size,8)
 end 
 
 -- weapon
 if aimline.visible then
  if player.invincible then
   pal(1,7)
  end
	 line(aimline.x1,aimline.y1,aimline.x2,aimline.y2,1)
	 pal()
	end

 -- projectiles 
 for p in all(projectiles) do
 	circfill(p.x,p.y,1,p.col)
 end
 
 -- rain
 for r in all(rain) do
  line(r.x,r.y,r.x,r.y+3,6)
 end
 
	-- light spot 
	fillp(0b0101101001011010.1)	
	circfill(player.x+4,player.y+4,36,0x1800)
	fillp()
	circfill(player.x+4,player.y+4,50,0x1800)
 
 -- mouse cursor
 spr(7,mousex,mousey)
 
  -- reset camera
 camera()
 
 --hud 
 print("\*5♥",0,2,1)
 for l=0,player.hp-1 do
  print("\^o2ff\8♥",l*8 + 4,2,8)
  circfill(l*8+1,3,0,7)  
 end
 
 print("\^o101\f7웃"..killcounter,42,2,7)
 
 -- running blood on plaers death
 for b in all(runningblood) do
  line(b.x,b.y,b.x,b.y+b.length,8)
 end
 
 if player.state == "dead" then
  local x=64-(#player.deathtext*2)
		print("\^o7ff\f8"..player.deathtext,x,60)
 end
 
 --print(player.timer.spdboost,0,0,7)
 --print("\^o7ff\f1outline",2,2)
end

-->8
-- utils

-- sine wave
function sine_wave(x,y,amp,frq)
	 local amplitude = amp
	 local frequency = frq
	 local speed = time() * 2
	 
	 return y + sin((x * frequency) + speed) * amplitude
end

-- random integer
function randi(n)
 return ceil(rnd(n))
end

-- distance between objects
function dist(o1,o2)
 return sqrt((o1.x - o2.x)^2 + (o1.y - o2.y)^2)
end

-- sprite animation 
function animate(tick,img,img_start,img_end,img_spd,img_stop)
	if tick % img_spd == 0 then
		img+=1
	end
	
	if img > img_end then
	 if img_stop then
	 	img=img_end
	 else
			img=img_start
		end
	end
		
	return img	
end

-- create new projectiles
function new_projectile(x,y,spd,ang,col)
 return {
  name="projectile",
  x=x,
  y=y,
  w=2,
  h=2,
  spd=spd,
  ang=ang,
  col=col
 }
end

-- create rain particles
function new_rain(x,y,spd)
 return {
  x=x,
  y=y,
  spd=spd
  }
end

-- create running blood
function new_runningblood(x,y)
	return {
	 x=x,
	 y=y,
	 spd=rnd(1),
	 length=1
	} 
end

-- create blood explosion effect
function blood_explosion(x,y)
  local particles={}
  for p=0,20  do
	  local xspd=flr(rnd(4)) - 2
	  local yspd=flr(rnd(5)) -10
	  local size=flr(rnd(2))
	  local yoffset=flr(rnd(4)) - 2
	  local xoffset=flr(rnd(4)) - 2 
	  
		 add(particles,
		  new_particle(x+xoffset,y+yoffset,xspd,yspd,size,8)
		 )
 	end
 	return particles
end

-- create a single particle with gravity
function new_particle(x,y,xspd,yspd,size,col)
 return {
 	x=x,
 	y=y,
 	yspd=yspd,
 	xspd=xspd,
 	grav=1,
 	size=size,
 	col=cole 	
 }
end

-- create blood
function create_blood(x,y)
 local xoffset = flr(rnd(6))-3
 local yoffset = flr(rnd(6))-3
 local radius = flr(rnd(3))
 return {
	 ttl=1000,
  x=x+xoffset+4,
  y=y+yoffset+4,
  r=radius
 }
end

-- create zombie
function new_zombie(sp) 
 local img=({8,8,8,24,24,12,28,28,16,16,16,20,32,32})[randi(14)]
 local imgs=img
 local imge=img+3
 local hp=randi(3) + 5
 local x = sp.x 
 local y = sp.y + 8
 local size = 8
 local spd=({0.1,0.25,0.5,0.75})[randi(4)]
 local col= ({1,2,5,6,8,9,10,12,13,14})[randi(10)]
 local col2=({1,2,5,6,8,9,10,12,13,14})[randi(10)]
 local dropchance=10
 
 -- enemy types.........
 -- * dog
 if img == 20 then
  spd=0.9
  col=-1
  col2=-1
  hp=3
  dropchance=5
 end
 
 -- * fatso
 if img == 12 then
  spd=0.25
  hp=randi(10) + 5
 end
 
 -- * infected
 if img == 32 then
  spd=0.1
  dropchance=1
  col=-1
  col2=-1
  hp=randi(15) + 5
 end
  
 return {
  hp=hp,
  timer={hit=15},
  name="zombie",
  state="walk",
  img=img,
  img_start=imgs,
  img_end=imge,
  old_x=x,
  old_y=y,
  x=x,
  y=y,
  w=size,
  h=size,
  spd=spd,
  ang=0,
  col=col,
  col2=col2,
  dropchance=dropchance,
  fliph=false
 }
end

-- create an item (powerup)
function new_item(img,x,y)

	return {
		img=img,
		w=8,
		h=8,
		x=x,
		y=y
	}
end

-- aabb collision
function aabb(obj1,obj2,offset) 

 return(
  obj1.x + offset < obj2.x + obj2.w - offset and
  obj1.x + obj1.w - offset > obj2.x + offset and
  obj1.y + offset < obj2.y + obj2.h - offset and
  obj1.y + obj1.h - offset > obj2.y	+ offset 
 )
end

-- check solid map-tiles
function is_solid(x,y) 
	if fget(mget(flr(x/8),flr(y/8)),0) then
		return true
	end
	
	return false
end

-- collision using is_solid (fget)
function collide(x,y,offset) 
 if is_solid(x+offset,y+offset) or
    is_solid(x+7-offset,y+offset) or
    is_solid(x+offset,y+7-offset) or
    is_solid(x+7-offset,y+7-offset) 
 then	
  return true
 end
 return false
end

-- check if object exit the game-map
function leave_area(x,y,mapx,mapy)
  if x > 128 + mapx or 
     x < 0 or 
     y > 128 + mapy or
     y < 0 
  then 
  	return true
  end
  return false
end

--insertion sort, ascending y
function isorty(t) 
	for n=2,#t do
		local i=n
		while i>1 and t[i].y<t[i-1].y do
			t[i],t[i-1]=t[i-1],t[i]
			i-=1
		end
	end
end

