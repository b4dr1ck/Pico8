-- utils

-- draw image of string
function draw_img(colormap)
	local rows=split(colormap,"\n",false)
 for y,r in pairs(rows) do
	 y-=1
	 if r then
	 	local columns=split(r,"",false) 
	 	for x,c in pairs(columns) do
	 	 if c != " " then
		 	 x-=1
		   rectfill(
		   	x,
		   	y,
		   	x,
		   	y,
		   	"0x"..c
		   )
		  end
	 	end
	 end
 end
end

-- sine wave
function sine_wave(x,y,amp,frq)
	 local amplitude = amp
	 local frequency = frq
	 local speed = time() * 2
	 
	 return y + sin((x * frequency) + speed) * amplitude
end

-- random integer
function randi(n)
 return ceil(rnd(n))
end

-- distance between objects
function dist(o1,o2)
 return sqrt((o1.x - o2.x)^2 + (o1.y - o2.y)^2)
end

-- sprite animation 
function animate(tick,img,img_start,img_end,img_spd,img_stop)
	if tick % img_spd == 0 then
		img+=1
	end
	
	if img > img_end then
	 if img_stop then
	 	img=img_end
	 else
			img=img_start
		end
	end
		
	return img	
end

-- create new projectiles
function new_projectile(x,y,spd,ang,col)
 return {
  name="projectile",
  x=x,
  y=y,
  w=2,
  h=2,
  spd=spd,
  ang=ang,
  col=col
 }
end

-- create running blood
function new_runningblood(x,y)
	return {
	 x=x,
	 y=y,
	 spd=rnd(1),
	 length=1
	} 
end

-- create blood explosion effect
function blood_explosion(x,y)
  local particles={}
  for p=0,20  do
	  local xspd=flr(rnd(4))-2
	  local yspd=flr(rnd(2))-2
	  local size=flr(rnd(2))
	  local yoffset=flr(rnd(4)) - 2
	  local xoffset=flr(rnd(4)) - 2 
	  
		 add(particles,
		  new_particle(x+xoffset,y+yoffset,xspd,yspd,size,8)
		 )
 	end
 	return particles
end

-- create a single particle with gravity
function new_particle(x,y,xspd,yspd,size,col)
 return {
 	x=x,
 	y=y,
 	yspd=yspd,
 	xspd=xspd,
 	grav=0.1,
 	size=size,
 	col=cole 	
 }
end

-- create blood
function new_blood(x,y)
 local xoffset = flr(rnd(6))-3
 local yoffset = flr(rnd(6))-3
 local radius = flr(rnd(3))
 
 return {
	 ttl=1000,
  x=x+xoffset+4,
  y=y+yoffset+4,
  r=radius
 }
end

-- create zombie
function new_zombie(sp) 
 local img=({8,8,8,8,
 											 24,24,12,28,
 											 28,16,32,16,
 											 20,16,37,37,
 											 37,41,41,41})[randi(20)]
 local imgs=img
 local imge=img+3
 local hp=randi(3) + 5
 local x = sp.x 
 local y = sp.y + 8
 local size = 8
 local spd=({0.1,0.25,0.5,0.75})[randi(4)]
 local col= ({1,2,5,6,8,9,10,12,13,14})[randi(10)]
 local col2=({1,2,5,6,8,9,10,12,13,14})[randi(10)]
 local dropchance=7

 -- enemy types.........
 -- * dog
 if img == 20 then
  spd=0.9
  col=-1
  col2=-1
  hp=3
  dropchance=3
 end
 
 -- * crawling
 if img == 37 then
	  spd=0.1
	  hp=3 
 end
 
 -- * fatso
 if img == 12 then
  spd=0.25
  hp=randi(10) + 5
 end
 
 -- * vomitter
 if img == 32 then
  spd=0.1
  dropchance=1
  col=-1
  col2=-1
  hp=randi(15) + 5
 end
  
 return {
  hp=hp,
  timer={hit=15,vomit=600},
  name="zombie",
  state="walk",
  img=img,
  img_start=imgs,
  img_end=imge,
  old_x=x,
  old_y=y,
  x=x,
  y=y,
  w=size,
  h=size,
  spd=spd,
  ang=0,
  col=col,
  col2=col2,
  dropchance=dropchance,
  fliph=false,
 }
end

-- create an item (powerup)
function new_item(img,x,y)

	return {
		img=img,
		w=8,
		h=8,
		x=x,
		y=y
	}
end

-- aabb collision
function aabb(obj1,obj2,offset) 

 return(
  obj1.x + offset < obj2.x + obj2.w - offset and
  obj1.x + obj1.w - offset > obj2.x + offset and
  obj1.y + offset < obj2.y + obj2.h - offset and
  obj1.y + obj1.h - offset > obj2.y	+ offset 
 )
end

-- check solid map-tiles
function is_solid(x,y) 
	if fget(mget(flr(x/8),flr(y/8)),0) then
		return true
	end
	
	return false
end

-- collision using is_solid (fget)
function collide(x,y,offset) 
 if is_solid(x+offset,y+offset) or
    is_solid(x+7-offset,y+offset) or
    is_solid(x+offset,y+7-offset) or
    is_solid(x+7-offset,y+7-offset) 
 then	
  return true
 end
 return false
end

-- check if object exit the game-map
function leave_area(x,y,mapx,mapy)
  if x > 128 + mapx or 
     x < 0 or 
     y > 128 + mapy or
     y < 0 
  then 
  	return true
  end
  return false
end

--insertion sort, ascending y
function isorty(t) 
	for n=2,#t do
		local i=n
		while i>1 and t[i].y<t[i-1].y do
			t[i],t[i-1]=t[i-1],t[i]
			i-=1
		end
	end
end

