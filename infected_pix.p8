pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- infected pixeld
-- BY BADRICK 2026

-----------------------------------

-- game loop
function _init()
 poke(0x5f2d,0x1)
 
 game_timer=0
 player={
  x=64,
  y=64,
  img=4,
  spd=1,
  flipx=false,
  state="idle",
  launchspd=10,
  }
 state_frames={
 	idle={4,5,20},
 	walk={1,4,10},
 	shoot={6,6,10},
 }
 projectiles={}
 aimline={
	 visible=false,
  x1=0,
  y1=0,
  x2=0,
  y2=0,
 }
  
end

function _update60()
 game_timer+=1
 
 mousex=stat(32)
 mousey=stat(33)
 mouseb=stat(34)
 
 angle = atan2(mousex-player.x,mousey-player.y)
 dx=0
 dy=0
 
 -- capture input
 if btn(⬅️) then dx=-1 end 
 if btn(➡️) then dx=1 end 
 if btn(⬆️) then dy=-1 end 
 if btn(⬇️) then dy=1 end 
 
 -- player movement
 player.x+=dx*player.spd
 player.y+=dy*player.spd
 
 -- create projectiles
 if (mouseb == 1) then
  player.state="shoot"
  aimline.visible=true
  if game_timer % player.launchspd == 0 then
	 	add(projectiles,
	 		new_projectile(
	 			player.x+4,
	 			player.y+4,
	 			2,
	 			angle,
	 			9)
	 		)
	 		sfx(0)
	 	end
	else
  aimline.visible=false
 end
 
 -- update projectiles
 for p in all(projectiles) do
  p.x += cos(p.ang) * p.spd
  p.y += sin(p.ang) * p.spd
  
  if p.x > 128 or 
     p.x < 0 or 
     p.y > 128 or
     p.y < 0 
  then 
   del(projectiles,p)    
  end 
 end
 
 -- aim line
	aimline.x1=player.x+4
	aimline.y1=player.y+4
	aimline.x2= player.x+4+cos(angle)*6
	aimline.y2= player.y+4+sin(angle)*6

 -- animations
 if dx != 0 or dy != 0 then
  player.state="walk"
 else 
  if (mouseb == 1) then
  	player.state="shoot"
  else
	 	player.state="idle"
 	end
 end

 if dx < 0 then
		player.flipx=true
	elseif dx > 0 then
		player.flipx=false
 end
 
 player.img = animate(
 														game_timer,
 														player.img,
 														state_frames[player.state][1],
 														state_frames[player.state][2],
 														state_frames[player.state][3],
 														false)

 -- rest game-timer
 if game_timer > 1000 then
  game_timer=0
 end
end

function _draw()
 cls()

 -- player
 spr(player.img,player.x,player.y,1,1,player.flipx)
 
 -- aim line
 if aimline.visible then
	 line(aimline.x1,aimline.y1,aimline.x2,aimline.y2,5)
	end
 
 -- projectiles 
 for p in all(projectiles) do
 	rectfill(p.x,p.y,p.x,p.y,p.col)
 end
 
 -- mouse cursor
 spr(7,mousex,mousey)
end

-->8

-- utils

-- sprite animation 
function animate(tick,img,img_start,img_end,img_spd,img_stop)
	if tick % img_spd == 0 then
		img+=1
	end
	
	if img > img_end then
	 if img_stop then
	 	img=img_end
	 else
			img=img_start
		end
	end
		
	return img	
end

-- create new projectiles
function new_projectile(x,y,spd,ang,col)
 return {
  x=x,
  y=y,
  spd=spd,
  ang=ang,
  col=col
 }
end

-- aabb collision
function collide(obj1,obj2,offset) 
 return(
  obj1.x + offset < obj2.x + obj2.w - offset and
  obj1.x + obj1.w - offset > obj2.x + offset and
  obj1.y + offset < obj2.y + obj2.h - offset and
  obj1.y + obj1.h - offset > obj2.y	+ offset 
 )
end

