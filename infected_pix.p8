pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- infected pixeld
-- BY BADRICK 2026

-----------------------------------

-- game loop
function _init() 
 sfx(6)
 
 poke(0x5f2d,0x1) -- active mouse
	poke(0x5f34,0x2) -- inverted draw operations
	 
 mapbounds_x=128
 mapbounds_y=128
 game_timer=0
 player={
  hp=10,
  name="player",
  dash=0,
  invincible=false,
  x=60,
  y=60,
  w=8,
  h=8,
  img=4,
  spd=1,
  fliph=false,
  state="idle",
  launchspd=15,
  }
 state_frames={
 	idle={4,5,20},
 	walk={1,4,10},
 	shoot={6,6,10},
 }

 projectiles={}
 rain={}
 zombies={}
 sprites={}
 blood={}
 particles={}
  
 aimline={
	 visible=false,
  x1=0,
  y1=0,
  x2=0,
  y2=0,
 }
 
 spawntimer=300
 spawnpoints={}
 
 -- set spawnpoints
 for x=1,31 do
  for y=1,31 do
   if fget(mget(x,y),1) do
    add(spawnpoints,{x=x*8,y=y*8})	
   end
  end
 end
 
 add(sprites,player)
end

function _update60()

 game_timer+=1
 
 -- update camera
 if player.invincible then
  -- shake camera effect
	 cam_x = mid(0, player.x - 64, mapbounds_x) + flr(rnd(5))-2
	 cam_y = mid(0, player.y - 64, mapbounds_y) + flr(rnd(5))-2
 else
	 cam_x = mid(0, player.x - 64, mapbounds_x) 
	 cam_y = mid(0, player.y - 64, mapbounds_y)
	end
 
 mousex=stat(32) + cam_x
 mousey=stat(33) + cam_y
 mouseb=stat(34)
 
 local mouse_angle = atan2(mousex-player.x,mousey-player.y)
 local dx=0
 local dy=0
 
 -- capture input
 if btn(⬅️) then dx=-1 end 
 if btn(➡️) then dx=1 end 
 if btn(⬆️) then dy=-1 end 
 if btn(⬇️) then dy=1 end 
 
 -- enemy spawner
 if game_timer % spawntimer == 0 and
    #zombies <= 50 
 then
  local imgopt={8,12}
  local img=imgopt[ceil(rnd(#imgopt))]
  local imgs=img
  local imge=img+3
  local hp=flr(rnd(6)) + 5
  local sp=spawnpoints[ceil(rnd(#spawnpoints))] 
  local x = sp.x + 8
  local y = sp.y + 8
  local size = 8
  local spdopt={0.1,0.25,0.5,0.75}
  local spd=spdopt[ceil(rnd(#spdopt))]
  local col= flr(rnd(16))
     
  sfx(3)
     
  add(zombies,
			new_zombie(
				img,
				imgs,
				imge,
				hp,
				x,y,
				size,
				spd,
				col
			)	 
 	)
 	add(sprites,zombies[#zombies])
 	
 	spawntimer=flr(rnd(100)) + 200
 end

 -- player movement
 local old_x=player.x
 player.x+=dx*player.spd
 
 if collide(player.x,player.y,2)
 then	    
		player.x = old_x    
 end
 
 local old_y=player.y
 player.y+=dy*player.spd
 
 if collide(player.x,player.y,2)
 then
		player.y = old_y    
 end
 
 -- player gets hit by zombie
 for z in all(zombies) do
  if aabb(player,z,0) then
   if not player.invincible then
   	player.hp -= 1
   	sfx(2)
				add(blood,create_blood(player.x,player.y))
   end
			player.invincible=true
  end
 end

 -- aim line (gun)
	aimline.x1=player.x+4
	aimline.y1=player.y+4
	aimline.x2= player.x+4+cos(mouse_angle)*6
	aimline.y2= player.y+4+sin(mouse_angle)*6

 -- player animations
 if dx != 0 or dy != 0 then
  player.state="walk"
 else 
  if (mouseb == 1) then
  	player.state="shoot"
  else
	 	player.state="idle"
 	end
 end
 
 if dx < 0 then
		player.fliph=true
	elseif dx > 0 then
		player.fliph=false
 end
 
 player.img = animate(
 														game_timer,
 														player.img,
 														state_frames[player.state][1],
 														state_frames[player.state][2],
 														state_frames[player.state][3],
 														false)

 
 -- enemies
 for z in all(zombies) do
  if z.hp <= 0 then
   sfx(6)
  	particles = blood_explosion(z.x+4,z.y+4)
   del(zombies,z)
   del(sprites,z)
  end
 
  -- movement
  z.old_x = z.x
  z.old_y = z.y
  
  z.ang = atan2(player.x-z.x,player.y-z.y) 
  
  -- collision with player or obstacle
  z.x += cos(z.ang) * z.spd
	 if aabb(z,player,2) or
	    collide(z.x,z.y,2)
	 then	    
			z.x = z.old_x    
	 end 
	 
	 z.y += sin(z.ang) * z.spd
	 if aabb(z,player,2) or
	    collide(z.x,z.y,2)
	 then	    
			z.y = z.old_y    
	 end
	 
		-- if enemy collides another enemy
		for z2 in all(zombies) do
			if aabb(z,z2,2) and
				  z2 != z
		 then
				z.x = z.old_x
				z.y = z.old_y
			end
		end
	 
	 -- animations
  if (player.x-z.x < 0) then
   z.fliph=true
  else
   z.fliph=false
  end
  
  z.img = animate(
 														game_timer,
 														z.img,
 														z.img_start,
 														z.img_end,
 														20,
 														false)
 end
 
 -- create rain
 if game_timer % 10 == 0 then
   local amount=flr(rnd(32))
   
 	 for x=0,amount do
		 	add(rain,
		 						new_rain(
		 						 flr(rnd(128))+cam_x,
		 						 flr(rnd(12)),
		 						 5
		 						 )
		 					)	
		 end
 end
 
 -- create projectiles
 if (mouseb == 1) then
  player.state="shoot"
  aimline.visible=true
  
  if game_timer % player.launchspd == 0 then
	 	add(projectiles,
	 		new_projectile(
	 			player.x+4,
	 			player.y+4,
	 			2,
	 			mouse_angle,
	 			9)
	 		)
	 		sfx(0)
	 	end
	else
  aimline.visible=false
 end

 -- update rain
 for r in all(rain) do
  r.y+=r.spd
  if leave_area(r.x,r.y,mapbounds_x,mapbounds_y)  
  then 
   del(rain,r)    
  end
 end
  
 -- update projectiles
 for p in all(projectiles) do
  p.x += cos(p.ang) * p.spd
  p.y += sin(p.ang) * p.spd
  
  if leave_area(p.x,p.y,mapbounds_x,mapbounds_y)  
  then 
   del(projectiles,p)    
  end 
  
  -- projectile hits zombie
  for z in all(zombies) do
	  if aabb(p,z,0) then

	  	z.state = "hit"	  
	  	z.hp -= 1
	  	
	  	sfx(1)
	  		
	  	del(projectiles,p)
	  	
	  	particles = blood_explosion(z.x+4,z.y+4)
    
    for b=0,3 do
		  	add(blood,create_blood(z.x,z.y))
		  end
	  end
  end
 end
 
 -- update particles
 for p in all(particles) do
  p.yspd += min(3,p.grav)
  p.x += p.xspd
  p.y += p.yspd
  
		if leave_area(p.x,p.y,mapbounds_x,mapbounds_y)  then
			del(particles,p)
		end
 end
  
 -- reset game-timer
 if game_timer > 1000 then
  game_timer=0
 end
end



function _draw()
 cls(1)

 -- set camera
 camera(cam_x, cam_y)
 
 -- map
 map(0,0)
 
 -- blood
 for b in all(blood) do
  circfill(b.x,b.y,b.r,8)
  b.ttl-=1
  if b.ttl <= 0 then
  	del(blood,b)
  end
 end
 
 -- sprites
 isorty(sprites)
 for s in all(sprites) do
  
  -- handle zombies
  if s.name == "zombie" then
	  pal(7,s.col)
	  
	  -- set color to red if hit
	  if s.state == "hit" then
	   for c=1,16 do
		  	pal(c,7)
	  	end
	  end
	  	  
	  -- reset zombie state
		 if game_timer % 15 == 0 then
		  s.state = "walk"
		 end
	 end
	 
	 if s.name == "player" then
	  if s.invincible then
	   for c=1,16 do
		  	pal(c,7)
	  	end
	  		  	
	  	if game_timer % 60 == 0 then
	  		s.invincible = false
	  	end  	
	  end
	 end
	 	 
	 -- render sprite
 	spr(s.img,s.x,s.y,1,1,s.fliph)
 	pal()
 end
 
 -- particles
 for p in all(particles) do
  circfill(p.x,p.y,p.size,8)
 end 
 
 -- weapon
 if aimline.visible then
  if player.invincible then
   pal(1,7)
  end
	 line(aimline.x1,aimline.y1,aimline.x2,aimline.y2,1)
	 pal()
	end

 -- projectiles 
 for p in all(projectiles) do
 	circfill(p.x,p.y,1,p.col)
 end
 
 -- rain
 for r in all(rain) do
  line(r.x,r.y,r.x,r.y+3,6)
 end
 
	-- light spot 
	fillp(0b0101101001011010.1)	
	circfill(player.x+4,player.y+4,36,0x1800)
	fillp()
	circfill(player.x+4,player.y+4,50,0x1800)
 
 -- mouse cursor
 spr(7,mousex,mousey)
 
  -- reset camera
 camera()
 
 --hud 
 for l=1,player.hp do
  print("\^o2ff\8♥",l*8 + 4,2,8)
 end
 
 --print(#spawnpoints,0,0,7)
 --print("\^o7ff\f1outline",2,2)
end

-->8
-- utils

-- sprite animation 
function animate(tick,img,img_start,img_end,img_spd,img_stop)
	if tick % img_spd == 0 then
		img+=1
	end
	
	if img > img_end then
	 if img_stop then
	 	img=img_end
	 else
			img=img_start
		end
	end
		
	return img	
end

-- create new projectiles
function new_projectile(x,y,spd,ang,col)
 return {
  name="projectile",
  x=x,
  y=y,
  w=2,
  h=2,
  spd=spd,
  ang=ang,
  col=col
 }
end

-- create rain particles
function new_rain(x,y,spd)
 return {
  x=x,
  y=y,
  spd=spd
  }
end

-- create blood explosion effect
function blood_explosion(x,y)
  local particles={}
  for p=0,20  do
	  local xspd=flr(rnd(4)) - 2
	  local yspd=flr(rnd(5)) -10
	  local size=flr(rnd(2))
	  local yoffset=flr(rnd(4)) - 2
	  local xoffset=flr(rnd(4)) - 2 
	  
		 add(particles,
		  new_particle(x+xoffset,y+yoffset,xspd,yspd,size,8)
		 )
 	end
 	return particles
end

-- create a single particle with gravity
function new_particle(x,y,xspd,yspd,size,col)
 return {
 	x=x,
 	y=y,
 	yspd=yspd,
 	xspd=xspd,
 	grav=1,
 	size=size,
 	col=cole 	
 }
end

-- create blood
function create_blood(x,y)
 local xoffset = flr(rnd(6))-3
 local yoffset = flr(rnd(6))-3
 local radius = flr(rnd(3))
 return {
	 ttl=1000,
  x=x+xoffset+4,
  y=y+yoffset+4,
  r=radius
 }
end

-- create zombie
function new_zombie(img,img_start,img_end,hp,x,y,size,spd,col) 

 return {
  hp=hp,
  name="zombie",
  state="walk",
  dmgtint=0,
  img=img,
  img_start=img_start,
  img_end=img_end,
  frames,
  old_x=x,
  old_y=y,
  x=x,
  y=y,
  w=size,
  h=size,
  spd=spd,
  ang=0,
  col=col,
  fliph=false
 }
end

-- aabb collision
function aabb(obj1,obj2,offset) 

 return(
  obj1.x + offset < obj2.x + obj2.w - offset and
  obj1.x + obj1.w - offset > obj2.x + offset and
  obj1.y + offset < obj2.y + obj2.h - offset and
  obj1.y + obj1.h - offset > obj2.y	+ offset 
 )
end

-- check solid map-tiles
function is_solid(x,y) 
	if fget(mget(flr(x/8),flr(y/8)),0) then
		return true
	end
	
	return false
end

-- collision using is_solid (fget)
function collide(x,y,offset) 
 if is_solid(x+offset,y+offset) or
    is_solid(x+7-offset,y+offset) or
    is_solid(x+offset,y+7-offset) or
    is_solid(x+7-offset,y+7-offset) 
 then	
  return true
 end
 return false
end

-- check if object exit the game-map
function leave_area(x,y,mapx,mapy)
  if x > 128 + mapx or 
     x < 0 or 
     y > 128 + mapy or
     y < 0 
  then 
  	return true
  end
  return false
end

--insertion sort, ascending y
function isorty(t) 
	for n=2,#t do
		local i=n
		while i>1 and t[i].y<t[i-1].y do
			t[i],t[i-1]=t[i-1],t[i]
			i-=1
		end
	end
end

