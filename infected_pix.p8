pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- infected pixels
-- BY BADRICK 2026

-----------------------------------

-- game loop
function _init() 
 sfx(6)
 
 poke(0x5f2d,0x1) -- active mouse
	poke(0x5f34,0x2) -- inverted draw operations
	 
	deathtextmap={
	"you are dead",
	"afk 4 evr",
	"fucked up, i guess",
	"you life ends here",
	"no more sorrows",
	"you are elimnated",
	"that's it",
	"say good bye"
	}
 mapbounds_x=128
 mapbounds_y=128
 game_state="mainmenu"
 game_timer=0
  
 killcounter=0
 killcounter_highscore=0
 new_highscore=false
 
 -- get data from storage
 cartdata("infected_pixels")
 saved_killcounter=dget(0)
 if saved_killcounter > 0 then
 	killcounter_highscore=saved_killcounter
 end
 	 
 lightspot1=0
 lightspot2=0
 player={
  deathtext=deathtextmap[randi(#deathtextmap)],
  timer={invincible=60,spdboost=300,slow=0,pill=600},
  hp=5,
  name="player",
  invincible=false,
  pill=false,
  x=60,
  y=60,
  w=8,
  h=8,
  img=4,
  spd=1,
  fliph=false,
  state="idle",
  launchfrq=30,
  launchspd=2,
  projectiles=1,
  }
  
 state_frames={
 	idle={4,5,20},
 	walk={1,4,10},
 	shoot={6,6,10},
 }

 projectiles={}
 rain={}
 zombies={}
 vomit={}
 sprites={}
 blood={}
 runningblood={}
 particles={}
 items={}
  
 aimline={
	 visible=false,
  x1=0,
  y1=0,
  x2=0,
  y2=0,
 }
 
 spawntimer=300
 st_offset=250
 spawnpoints={}

 -- set spawnpoints
 for x=1,31 do
  for y=1,31 do
   if fget(mget(x,y),1) do
    add(spawnpoints,{x=x*8,y=y*8})	
   end
  end
 end
 
	add(sprites,player)

end

function _update60()
 game_timer+=1

 if game_state == "game" then
	 -- update camera
	 if player.invincible and not player.pill then
	  -- shake camera effect
		 cam_x = mid(0, player.x - 64, mapbounds_x) + randi(5)-2
		 cam_y = mid(0, player.y - 64, mapbounds_y) + randi(5)-2
	 else
		 cam_x = mid(0, player.x - 64, mapbounds_x) 
		 cam_y = mid(0, player.y - 64, mapbounds_y)
		end
		
	 -- enemy spawner
	 if game_timer % spawntimer == 0 and
	    #zombies <= 30 and
	    player.state != "dead"    
	 then

	  sfx(3)
	   
   local rand_spawn_index=randi(#spawnpoints)
	  local spawnpoint = spawnpoints[rand_spawn_index]  
   
		 add(zombies,new_zombie(spawnpoint))
		 add(sprites,zombies[#zombies])
		 
		 -- delete if a new spawned zombie overlaps another
		 for z in all(zombies) do
		  if aabb(z,{
		  											x=spawnpoint.x,
		  											y=spawnpoint.y,
		  											w=8,h=8
		  											},0)
				then
					del(zombies,z)
					del(sprites,z)
				end
		 end
   
   -- st_offset based on power 
   if player.projectiles > 1 and
      player.launchfrq <= 20 
   then
    st_offset = 125   
   end
   
   if player.projectiles > 2 and
      player.launchfrq <= 15 
   then
    st_offset = 50   
   end

	 	spawntimer=randi(50) + st_offset
	 end
	 
	 -- capture mouse input
	 mousex=stat(32) + cam_x
	 mousey=stat(33) + cam_y
	 mouseb=stat(34)
	 
	 local mouse_angle = atan2(mousex-(player.x+4),mousey-(player.y+4))
	 local dx=0
	 local dy=0
	 
	 -- capture keyboard input
	 if btn(⬅️) then dx=-1 end 
	 if btn(➡️) then dx=1 end 
	 if btn(⬆️) then dy=-1 end 
	 if btn(⬇️) then dy=1 end 
	 
	 if btnp(❎) and
	    player.state == "dead"
	 then 
	 	_init()
	 end
	 
	 -- players death
	 if player.state == "dead" then
	  player.img = -1
		 if game_timer % 60 == 0 then
		  local x=randi(127)
		  if #runningblood < 100 then
			  add(runningblood,new_runningblood(x,0))
		  end
		 end
		 
		 for b in all(runningblood) do
		  if b.length < 127 then
			  b.length+=b.spd
			 end
		 end
		else
		
		 -- speed boost
		 if player.spd > 1 and
		    player.timer.spdboost > 0  
		 then
		 	player.timer.spdboost-=1 
		 end
		 
		 if player.timer.spdboost == 0 then
		  player.spd=1
		  player.timer.spdboost=300 
		 end
		 
		 -- slow debuff
		 if player.timer.slow > 0 then
		  player.timer.slow-=1
		  player.spd = 0.25
		 elseif player.timer.spdboost == 300 then
		  player.spd = 1
		 end
	
		 -- player movement
		 local old_x=player.x
		 player.x+=dx*player.spd
		 
		 if collide(player.x,player.y,2)
		 then	    
				player.x = old_x    
		 end
		 
		 local old_y=player.y
		 player.y+=dy*player.spd
		 
		 if collide(player.x,player.y,2)
		 then
				player.y = old_y    
		 end
		
		 -- player gets hit by zombie
		 for z in all(zombies) do
		  if aabb(player,z,0) then
		   if not player.invincible and
		      not player.pill
		   then
		   	--player.hp -= 1
		   	sfx(2)
						add(blood,new_blood(player.x,player.y))
	     
	     -- and dies...
						if player.hp <= 0 then
						 if killcounter > killcounter_highscore then
						  killcounter_highscore=killcounter
		      cartdata("infected_pixels")
		      dset(0,killcounter_highscore)
		      new_highscore=true
						 end
						
		 	  	particles = blood_explosion(player.x+4,player.y+4)
		 	  	for i=1,5 do
			 	  	add(blood,new_blood(player.x,player.y))
			 	  end
			 	  sfx(7)
						 player.state = "dead"
						end
		   end
		   if not player.pill then
						player.invincible=true
					end
		  end
		 end
		
		 -- aim line (gun)
			aimline.x1=player.x+4
			aimline.y1=player.y+4
			aimline.x2=player.x+4+cos(mouse_angle)*6
			aimline.y2=player.y+4+sin(mouse_angle)*6
		
		 -- player animations
		 if player.state != "dead" then
			 if dx != 0 or dy != 0 then
			  player.state="walk"
			 else 
			  if (mouseb == 1) then
			  	player.state="shoot"
			  else
				 	player.state="idle"
			 	end
			 end
			 
			 if dx < 0 then
					player.fliph=true
				elseif dx > 0 then
					player.fliph=false
			 end
			 
			 player.img = animate(
			 														game_timer,
			 														player.img,
			 														state_frames[player.state][1],
			 														state_frames[player.state][2],
			 														state_frames[player.state][3],
			 														false)
	  end
		end
		 
		 
	 -- enemies
	 for z in all(zombies) do
	  if z.state == "walk" then
	   -- zombie dies
		  if z.hp <= 0 then
		   sfx(5)
		  	particles = blood_explosion(z.x+4,z.y+4)
	    
	    killcounter+=1
	    
		    -- drop items
	    local itemimg=({128,129,130,131,132})[randi(5)]
	    local dc=randi(z.dropchance)

     --printh(z.dropchance.."/"..dc)
     
		  	if dc == z.dropchance then
	     add(items,new_item(itemimg,z.x,z.y))
		  	end
		  	
		   del(zombies,z)
		   del(sprites,z)
		  end
		 
		  -- special zombie behaivor
		  
		  -- * vomitter 
		  if z.img_start == 32 then
		   z.timer.vomit-=1
		   
			  if z.timer.vomit == 0 then
			    add(vomit,{img=36,
			    											x=z.x+4,
			    											y=z.y+4,
			    											w=8,h=8,
			    											ttl=1200
			    											})
			    z.timer.vomit = 600
			    sfx(8)
			  end
		  end
		  
		  -- * crawling
		  if z.img_start == 37 then
		   if game_timer % 20 == 0 then
			   add(blood,new_blood(z.x,z.y))
		   end
		  end
		 
		  -- movement
		  z.old_x = z.x
		  z.old_y = z.y
		  
		  if player.state != "dead" then
		   z.ang = atan2(player.x-z.x,player.y-z.y) 
			  
			  -- collision with player or obstacle
			  z.x += cos(z.ang) * z.spd
				 if aabb(z,player,2) or
				    collide(z.x,z.y,2)
				 then	    
						z.x = z.old_x    
				 end 
				 
				 z.y += sin(z.ang) * z.spd
				 if aabb(z,player,2) or
				    collide(z.x,z.y,2)
				 then	    
						z.y = z.old_y    
				 end
			 end
			 
				-- if enemy collides another enemy
				for z2 in all(zombies) do
					if aabb(z,z2,2) and
						  z2 != z
				 then
						z.x = z.old_x
						z.y = z.old_y
					end
				end
			 
			 -- animations
		  if (player.x-z.x < 0) then
		   z.fliph=true
		  else
		   z.fliph=false
		  end
		  
		  z.img = animate(
													game_timer,
													z.img,
													z.img_start,
													z.img_end,
													20,
													false)
	  end
	 end
	 
	 -- create rain
	 if game_timer % 10 == 0 then
	   local amount=randi(32)
	   
	 	 for x=0,amount do
			 	add(rain,
			 						{
			 						 x=randi(128)+cam_x,
			 						 y=randi(12),
			 						 spd=5
			 						 }
			 					)	
			 end
	 end
	 
	 -- create projectiles 
	 if (mouseb == 1 and player.state != "dead") then
	  player.state="shoot"
	  aimline.visible=true
	  
	  if game_timer % player.launchfrq == 0 then
	   local spread_angle=0.04
	   
	   -- create one or multiple p
	   for p=1,player.projectiles do
	    local angle_offset=(p-(player.projectiles+1)/2)*spread_angle
	    add(projectiles,
	     new_projectile(
	      player.x+4,
	      player.y+4,
	      player.launchspd,
	      mouse_angle+angle_offset,
	      9)
	    )
	   end
		 		sfx(0)
		 	end
		else
	  aimline.visible=false
	 end
	
	 -- vomit
	 for v in all(vomit) do
	 	v.ttl-=1
	 	if v.ttl <= 0 do
	 	 del(vomit,v)
	 	end
	 	
	 	-- collision
	 	if aabb(player,v,0) then
	 		player.timer.slow=60
	 	end
	 end
	
	 -- items
	 for i in all(items) do
	 
	  -- collisions
	  if aabb(player,i,2) then
	   sfx(4)
	   
	   -- medipacks
	   if i.img == 128 then
	    player.hp=min(10,player.hp+1)
	   end
	   
	   -- energy drink
	   if i.img == 129 then
	    player.spd=min(2,player.spd+1)
	   end
	   
	   -- launchfrq down
	   if i.img == 130 then
	    player.launchfrq=max(5,player.launchfrq-5)
	   end
	   
	   -- projectiles up
	   if i.img == 131 then
	    player.projectiles=min(6,player.projectiles+1)
	   end
	   
	   -- invincible
	   if i.img == 132 then
	   	player.pill = true
	   	player.timer.pill=600
	   	sfx(10)
	   end
	   
	   del(items,i)
	  end
	  i.y = sine_wave(i.x,i.y,0.5,0.05)
	    						
	 end
	
	 -- update rain
	 for r in all(rain) do
	  r.y+=r.spd
	  if leave_area(r.x,r.y,mapbounds_x,mapbounds_y)  
	  then 
	   del(rain,r)    
	  end
	 end
	  
	 -- update projectiles
	 for p in all(projectiles) do
	  p.x += cos(p.ang) * p.spd
	  p.y += sin(p.ang) * p.spd
	  
	  if leave_area(p.x,p.y,mapbounds_x,mapbounds_y)  
	  then 
	   del(projectiles,p)    
	  end 
	  
	  -- projectile hits zombie
	  for z in all(zombies) do
		  if aabb(p,z,0) then
	
		  	z.state = "hit"	  
		  	z.hp -= 1
		  	
		  	sfx(1)
		  	
	  		
		  	del(projectiles,p)
		  	
		  	particles = blood_explosion(z.x+4,z.y+4)
	    
	    for b=0,3 do
			  	add(blood,new_blood(z.x,z.y))
			  end
		  end
	  end
	 end
	 
	 -- update particles
	 for p in all(particles) do
	  p.yspd += min(3,p.grav)
	  p.x += p.xspd
	  p.y += p.yspd
	  
			if leave_area(p.x,p.y,mapbounds_x,mapbounds_y)  then
				del(particles,p)
			end
	 end
	
	-- main menu 
	elseif game_state == "mainmenu" then
	 
	 if btnp(❎) then
	  game_state="game"
	  sfx(9)
	 end
	 
	end

 -- reset game-timer
 if game_timer > 3600 then
  game_timer=0
 end
end

--------------------------------------
function _draw()
 cls(0)
 
 if game_state == "game" then
	 -- set camera
	 camera(cam_x, cam_y)
	 
	 -- map
	 map(0,0)
	 
	 -- blood
	 for b in all(blood) do
	  circfill(b.x,b.y,b.r,8)
	  b.ttl-=1
	  if b.ttl <= 0 then
	  	del(blood,b)
	  end
	 end
	 
	 -- vomit
	 for v in all(vomit) do
	  spr(v.img, v.x, v.y)
	 end
	 
	 -- items
	 for i in all(items) do
	  spr(i.img,i.x,i.y)
	 end
	 
	 -- sprites
	 isorty(sprites)
	 for s in all(sprites) do
	  
	  -- handle zombies
	  if s.name == "zombie" then
	   -- recolor 
	   if s.col > 0 then
		  	pal(7,s.col)
		  end
		  if s.col2 > 0 then
			  pal(1,s.col2)
			 end
		  
		  -- set color to white if hit
		  if s.state == "hit" then
		   s.timer.hit -= 1
		   for c=1,16 do
			  	pal(c,7)
		  	end
		  	
			  -- reset zombie state
				 if s.timer.hit == 0 then
				  s.state = "walk"
				  s.timer.hit = 15
				 end
		  end

		 end
		 
		 -- handle player
		 if s.name == "player" then
		 
		  -- invincible on pill item
		  if s.pill then
		   s.timer.pill-=1
		   
		   if flr(time()*10) % 5 == 0 then
			   for c=1,16 do
				  	pal(c,10)
			  	end
			  else
			   pal()
			  end
			  
		  	if s.timer.pill == 0 then
		  	 s.pill = false
		  	 s.timer.pill = 600
		  	end
		  end
		  
		  -- invincible on hit
		  if s.invincible and not s.pill then
			  s.timer.invincible-=1
			  if flr(time()) % 2 == 0 then
			   for c=1,16 do
				  	pal(c,7)
			  	end
		  	end
		  		  	
		  	if s.timer.invincible == 0 then
		  		s.invincible = false
		  		s.timer.invincible=60
		  	end  	
		  end
		 end
		 	 
		 -- render player/zombie-sprites
	 	spr(s.img,s.x,s.y,1,1,s.fliph)

	 	-- rest color replacements
		 pal()
	 end

	 -- particles
	 for p in all(particles) do
	  circfill(p.x,p.y,p.size,8)
	 end 
	 
	 -- weapon
	 if aimline.visible then
	  if player.invincible then
	   pal(1,7)
	  end
		 line(aimline.x1,aimline.y1,aimline.x2,aimline.y2,1)
		 pal()
		end
	
	 -- projectiles 
	 for p in all(projectiles) do
	 	circfill(p.x,p.y,1,p.col)
	 end
	 
	 -- rain
	 for r in all(rain) do
	  line(r.x,r.y,r.x,r.y+3,6)
	 end
	 
		-- light spot 
		if lightspot1 < 36 then
		 lightspot1+=1
		end
		
		if lightspot2 < 50 then
		 lightspot2+=1
		end
		
		fillp(0b0101101001011010.1)	
		circfill(player.x+4,player.y+4,lightspot1,0x1800)
		fillp()
		circfill(player.x+4,player.y+4,lightspot2,0x1800)
	 
	 -- mouse cursor
	 spr(7,mousex,mousey)
	 
	  -- reset camera
	 camera()
	  	 
	 --hud 
	 print("\*5♥",0,2,1)
	 for l=0,player.hp-1 do
	  print("\^o2ff\8♥",l*8 + 4,2,8)
	  if player.pill then
		  print("\^o9ff\8♥",l*8 + 4,2,10)
	  end
	  circfill(l*8+1,3,0,7)  
	 end
	 
	 print("\^o101\f7웃"..killcounter,42,2,7)
	 print("\^o101\f8웃"..killcounter_highscore,60,2,7)
	  
	 print(#zombies,0,16,7)
	 print(st_offset,0,24,7)
	 
	 if player.state == "dead" then
		 -- running blood on players death
		 for b in all(runningblood) do
		  line(b.x,b.y,b.x,b.y+b.length,8)
		 end
		 
	  local x=64-(#player.deathtext*2)
			print("\^o7ff\f8"..player.deathtext,x,60)
	  print("\^o8ff\f7PRESS ❎ TO RESTART",27,sine_wave(x,70,2,0.05),7)
	  
	  if new_highscore then
	   print("new highscore",78,2,10)
	  end
	 end
	 	 	 
	-- main menu
 elseif game_state == "mainmenu" then
   
  -- background image 
  local cm=[[
111111dddddddddddd666666666666666682222222111111111111111111112222122112222222222111266666666666666666666dddddd1111111111111111
