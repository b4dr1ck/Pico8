pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- infected pixeld
-- BY BADRICK 2026

-----------------------------------

-- game loop
function _init()
 poke(0x5f2d,0x1) -- active mouse
	poke(0x5f34,0x2) -- inverted draw operations
	
 debug="abc"
 
 mapbounds_x=128
 mapbounds_y=128
 game_timer=0
 player={
  x=60,
  y=60,
  img=4,
  spd=1,
  flipx=false,
  state="idle",
  launchspd=15,
  }
 state_frames={
 	idle={4,5,20},
 	walk={1,4,10},
 	shoot={6,6,10},
 }

 projectiles={}
 rain={}
  
 aimline={
	 visible=false,
  x1=0,
  y1=0,
  x2=0,
  y2=0,
 }
  
end

function _update60()
 game_timer+=1
 
  -- update camera
 cam_x = mid(0, player.x - 64, mapbounds_x)
 cam_y = mid(0, player.y - 64, mapbounds_y)
 
 mousex=stat(32) + cam_x
 mousey=stat(33) + cam_y
 mouseb=stat(34)
 
 local angle = atan2(mousex-player.x,mousey-player.y)
 local dx=0
 local dy=0
 
 -- capture input
 if btn(⬅️) then dx=-1 end 
 if btn(➡️) then dx=1 end 
 if btn(⬆️) then dy=-1 end 
 if btn(⬇️) then dy=1 end 
 
 -- player movement
 local old_x=player.x
 player.x+=dx*player.spd
 
 if collide(x,y,2)
 then	    
		player.x = old_x    
 end
 
 local old_y=player.y
 player.y+=dy*player.spd
 
 if collide(x,y,2)
 then
		player.y = old_y    
 end
 
 -- create rain
 if game_timer % 10 == 0 then
 	 for x=0,flr(rnd(16)) do
		 	add(rain,
		 						new_rain(
		 						 flr(rnd(128))+cam_x,
		 						 0-flr(rnd(12)),
		 						 5,
		 						 0.25
		 						 )
		 					)	
		 end
 end
 
 -- create projectiles
 if (mouseb == 1) then
  player.state="shoot"
  aimline.visible=true
  if game_timer % player.launchspd == 0 then
	 	add(projectiles,
	 		new_projectile(
	 			player.x+4,
	 			player.y+4,
	 			2,
	 			angle,
	 			9)
	 		)
	 		sfx(0)
	 	end
	else
  aimline.visible=false
 end
 
 -- update projectiles
 for p in all(projectiles) do
  p.x += cos(p.ang) * p.spd
  p.y += sin(p.ang) * p.spd
  
  if p.x > 128 + mapbounds_x or 
     p.x < 0 or 
     p.y > 128 + mapbounds_y or
     p.y < 0 
  then 
   del(projectiles,p)    
  end 
 end
 
 -- update rain
 for r in all(rain) do
  r.y+=r.spd
 end
 
 -- aim line (gun)
	aimline.x1=player.x+4
	aimline.y1=player.y+4
	aimline.x2= player.x+4+cos(angle)*6
	aimline.y2= player.y+4+sin(angle)*6

 -- animations
 if dx != 0 or dy != 0 then
  player.state="walk"
 else 
  if (mouseb == 1) then
  	player.state="shoot"
  else
	 	player.state="idle"
 	end
 end

 if dx < 0 then
		player.flipx=true
	elseif dx > 0 then
		player.flipx=false
 end
 
 player.img = animate(
 														game_timer,
 														player.img,
 														state_frames[player.state][1],
 														state_frames[player.state][2],
 														state_frames[player.state][3],
 														false)

 -- reset game-timer
 if game_timer > 1000 then
  game_timer=0
 end
 
end

function _draw()
 cls(1)

 -- set camera
 camera(cam_x, cam_y)
 
 -- map
 map(0,0)
 
 -- player
 spr(player.img,player.x,player.y,1,1,player.flipx)
 
 -- weapon
 if aimline.visible then
	 line(aimline.x1,aimline.y1,aimline.x2,aimline.y2,1)
	end
 
 -- projectiles 
 for p in all(projectiles) do
 	circfill(p.x,p.y,0,p.col)
 end
 

 -- rain
 for r in all(rain) do
  line(r.x,r.y,r.x,r.y+3,6)
 end
 
	-- light spot 
	fillp(0b0101101001011010.1)	
	circfill(player.x+4,player.y+4,36,0x1800)
	fillp()
	circfill(player.x+4,player.y+4,45,0x1800)
 

 -- mouse cursor
 spr(7,mousex,mousey)
 
  -- reset camera
 camera()
 --hud 
 print(debug,0,0,7)
end

-->8
-- utils

-- sprite animation 
function animate(tick,img,img_start,img_end,img_spd,img_stop)
	if tick % img_spd == 0 then
		img+=1
	end
	
	if img > img_end then
	 if img_stop then
	 	img=img_end
	 else
			img=img_start
		end
	end
		
	return img	
end

-- create new projectiles
function new_projectile(x,y,spd,ang,col)
 return {
  x=x,
  y=y,
  spd=spd,
  ang=ang,
  col=col
 }
end

-- create rain drop
function new_rain(x,y,spd,ang)
 return {
  x=x,
  y=y,
  spd=spd,
  ang=ang
  }
end

-- aabb collision
function aabb(obj1,obj2,offset) 
 return(
  obj1.x + offset < obj2.x + obj2.w - offset and
  obj1.x + obj1.w - offset > obj2.x + offset and
  obj1.y + offset < obj2.y + obj2.h - offset and
  obj1.y + obj1.h - offset > obj2.y	+ offset 
 )
end

-- check solid map-tiles
function is_solid(x,y) 
	if fget(mget(flr(x/8),flr(y/8)),0) then
		return true
	end
	
	return false
end

-- collision using is_solid (fget)
function collide(x,y,offset) 
 if is_solid(player.x+offset,player.y+offset) or
    is_solid(player.x+7-offset,player.y+offset) or
    is_solid(player.x+offset,player.y+7-offset) or
    is_solid(player.x+7-offset,player.y+7-offset) 
 then	
  return true
 end
 return false
end
