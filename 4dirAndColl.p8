pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

function is_solid(x,y)
 if fget(mget(flr(x/8),flr(y/8)),0) then
 	return true
 end
 return false
end

function _init()
 player={
  x=64,
  y=64,
  spd=1,
 }
end

function _update60()

 -- move x-axis
 --  right
 if btn(➡️) then
  player.x += 1 * player.spd
  
	 --  check right collision
	 if is_solid(player.x+7,player.y) or
				 is_solid(player.x+7,player.y+7)
	 then
	  player.x -= 1 * player.spd
	 end
	--  left
 elseif btn(⬅️) then
  player.x -= 1 * player.spd
		  
		-- check left collision
		if is_solid(player.x,player.y) or
				 is_solid(player.x,player.y+7)
		then
		 player.x += 1 * player.spd
		end
 end
 

 -- move y-axis
 --  down 
 if btn(⬇️) then
  player.y += 1 * player.spd
	 --  check down collision
	 if is_solid(player.x,player.y+7) or
				 is_solid(player.x+7,player.y+7)
	 then
	  player.y -= 1 * player.spd
	 end
	 -- up
 elseif btn(⬆️) then
  player.y -= 1 * player.spd
	 --  check up collision
	 if is_solid(player.x,player.y) or
				 is_solid(player.x+7,player.y)
	 then
	  player.y += 1 * player.spd
	 end
 end
end

function _draw()
 cls()
 map(0,0)
 
 spr(2,player.x,player.y)
 print(is_solid(player.x,player.y))
end
