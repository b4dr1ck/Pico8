pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

function _init()
 ball={
  x=64,
  y=64,
  r=4,
  spd=1,
  angle=rnd(1)
 }
 
 
end

function _update60()

 ball.x += cos(ball.angle) * ball.spd
 ball.y += sin(ball.angle) * ball.spd 

end

function _draw()
 cls()
 circfill(ball.x,ball.y,ball.r,8)

end


