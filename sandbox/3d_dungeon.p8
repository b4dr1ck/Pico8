pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

local cy=64       -- horizon
local h0,h1=64,18 -- half height: near edge, far edge
local mx,my=0,0   -- top-left map cell of the wall texture
local uw,vh=2,2   -- map cells used across / down the wall
local wall_count=4

function sidewall(z0,z1,dir,texture_x,texture_y)
	local cx=63.5
	local x0,x1
	if dir==1 then
		x0=flr(cx-h0/z0)
		x1=flr(cx-h0/z1)
	else
		x0=127-flr(cx-h0/z0)
		x1=127-flr(cx-h0/z1)
	end

	for x=x0,x1,dir do
		if x>=0 and x<=127 then
			local h=abs(x-cx)
			local z=h0/h
			local t=(z-z0)/(z1-z0)
			local u=texture_x+uw*t
			tline(x,cy-h,x,cy+h,u,texture_y,0,vh/(2*h))
		end
	end
end

function frontwall(z,dir,texture_x,texture_y)
	local cx=64
	local h=h0/z
	local edge=flr(cx-h0/z)
	local x0,x1
	if dir==1 then
		x0=0
		x1=edge
	else
		x0=127-edge
		x1=127
	end
	for x=x0,x1 do
		local t=(x-x0)/(x1-x0)
		local u=texture_x+uw*t
		tline(x,cy-h,x,cy+h,u,texture_y,0,vh/(2*h))
	end
end

function _draw()
	cls(0)
	rectfill(0,64,128,128,4)
	
	local zfar=h0/h1
	local zleft=1+(zfar-1)*2/wall_count
	local zright=1+(zfar-1)*3/wall_count

	for i=wall_count-1,0,-1 do
		local z0=1+(zfar-1)*i/wall_count
		local z1=1+(zfar-1)*(i+1)/wall_count
	
	 if i != 1 then
			sidewall(z0,z1,1,0,0)
		end
		
		if i == 1 then
			frontwall(zleft,1,0,0) 
		end
		
		if i != 2 then
			sidewall(z0,z1,-1,0,0)
		end
		
		if i == 2 then	
			frontwall(zright,-1,0,0)
		end
	end
	
	
end
