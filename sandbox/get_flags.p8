pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

function _init()
 flag=-1
 tile=-1
end

function _update()
 tile=mget(2,0)
 flag=fget(tile)
end

function _draw()
 cls()
 map(0,0)
	for y=0,15 do
	 for x=0,15 do
		 tile=mget(x,y)
		 flag=fget(tile)
	  print(flag,x*8,y*8,7)
	 end
	end
end
