pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function dist(o1,o2) 
 return sqrt((o1.x - o2.x )^2 + (o1.y - o2.y)^2 )
end

function get_sprite_pixel(s, px, py)
 local sx = (s % 16) * 8 + px
 local sy = flr(s / 16) * 8 + py
 return sget(sx, sy)
end

function create_ray(x,y,angle)
	local i=0
 ray={x1=x,y1=y,angle=angle}
 while (i<127) do
  i+=1
  ray.x1+=cos(ray.angle)*2
  ray.y1+=sin(ray.angle)*2
  local tile=mget(ray.x1/8,ray.y1/8)
  if fget(flr(tile),0) then
  	return {ray.x1,
  									ray.y1,
  									tile,
											get_sprite_pixel(tile,1,1),
  									}		
  end
 end
 return {0,0}
end

function _init()
 p={x=64,y=64,dir=0,spd=1}
 rays={}
 view=true
 maxrays=127
 fov=1/6
 steps=fov/maxrays
 
 for i=1,maxrays do
		add(rays,create_ray(p.x,p.y,p.dir+(steps*(i-(maxrays/2)))))
	end
end

function _update60()
 if btnp(❎) then
  view= not view
 end
 
 if btn(➡️) then
  p.dir+=0.01
  rays={}
	 for i=1,maxrays do
			add(rays,create_ray(p.x,p.y,p.dir+(steps*(i-(maxrays/2)))))
		end
 end
 
 if btn(⬅️) then
  p.dir-=0.01
  rays={}
	 for i=1,maxrays do
			add(rays,create_ray(p.x,p.y,p.dir+(steps*(i-(maxrays/2)))))
		end
 end
 
 if btn(⬆️) then
  local oldx=p.x
  local oldy=p.y
  
  p.y+=sin(p.dir)*p.spd
  -- collison
  if fget(flr(mget(p.x/8,p.y/8)),0) then
   p.y=oldy
  end
  p.x+=cos(p.dir)*p.spd
  -- collison
  if fget(flr(mget(p.x/8,p.y/8)),0) then
   p.x=oldx
  end
  
  rays={}
	 for i=1,maxrays do
			add(rays,create_ray(p.x,p.y,p.dir+(steps*(i-(maxrays/2)))))
		end
 end

 
 if btn(⬇️) then
  local oldx=p.x
  local oldy=p.y
  
  p.y-=sin(p.dir)*p.spd
  -- collison
  if fget(flr(mget(p.x/8,p.y/8)),0) then
   p.y=oldy
  end
  
  p.x-=cos(p.dir)*p.spd
  -- collison
  if fget(flr(mget(p.x/8,p.y/8)),0) then
   p.x=oldx
  end
   
  rays={}
	 for i=1,maxrays do
			add(rays,create_ray(p.x,p.y,p.dir+(steps*(i-(maxrays/2)))))
		end
 end
end

function _draw()
	cls()
	
	rectfill(0,64,128,128,4)
	
 -- 3d view
 for i=1,#rays do
  local x2=rays[i][1]
  local y2=rays[i][2]
  local ray_offset=steps*(i-(maxrays/2))
  local d=flr(dist({x=p.x,y=p.y},{x=x2,y=y2})*cos(ray_offset))
  local c=rays[i][4]
		local tile=rays[i][3]
		
		if x2 != 0 and y2 != 0 then
		 local wall_h=min(128,flr(930/max(d,1)))
		 --printh("d:".. d .. " index: "..i.."h:" .. wall_h)
		 local top=64-wall_h/2
		 local bottom=64+wall_h/2
			rect((i-1)*1,top,(i-1)*1+1,bottom,c)
		end
	end
	
 -- topdown view
 if view then
	 
	 cls(0)
	 for i=1,#rays do
	  local x2=rays[i][1]
	  local y2=rays[i][2]
		 line(p.x,p.y,x2,y2,10)
		end
		
		circfill(p.x,p.y,1,8)
 
		map(0,0)
	end
	
	print("PRESS ❎ TO SWITCH VIEW",1,1,7)
end
