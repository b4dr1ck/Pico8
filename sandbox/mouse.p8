pico-8 cartridge // http://www.pico-8.com
version 43
__lua__


function new_circ(x,y,r,c)
 circle={}
 circle.x = x
 circle.y = y
 circle.r = r
 circle.c = c
 circle.s = 0
 circle.f = false
 
 return circle
end


function _init()
 -- enable mousesupport
	poke(0x5f2d,0x1) 
	
	mousex=0
	mousey=0
	
	log=""

	circles={}
	maxcirc=25
	
	for x=1,maxcirc do
	
		rndy=flr(rnd(128))
		rndx=flr(rnd(32))
		rndr=flr(rnd(15)) + 1
		rndc=flr(rnd(15)) + 1
		rnds=rnd(1) 
	
		add(
			circles,
			new_circ(-rndx,rndy,rndr,rndc)
			)
		
		circles[x].s = rnds
			
 end
end

function _update60()
 for c in all(circles) do
  c.x += c.s
  if c.x > 128 + c.r then
   c.x = -c.r
			c.y=flr(rnd(128))
			c.r=flr(rnd(15)) + 1
			c.c=flr(rnd(15)) + 1
			c.s=rnd(1) 
  end
  
 if mouseb == 1 then
  if 
  	mousex < c.x + c.r and
  	mousex > c.x - c.r and
  	mousey < c.y + c.r and
  	mousey > c.y - c.r
	 then
	 	c.s=0
	 	c.f=true
  end
 end
  
 end
 
 mousex=stat(32)
 mousey=stat(33)
 mouseb=stat(34)
  
end

function _draw()	
 cls()
	for c in all(circles) do
	 if c.f then
		 circfill(c.x, c.y, c.r, c.c)
	 else
	  circ(c.x, c.y, c.r, c.c)
	 end
	end
	
		
 print(mousex,0,0,7)
 print(mousey,0,8,7)
 print(mouseb,0,16,7)
	
	rectfill(mousex,mousey,mousex+1,mousey+1,7)
	
	--spr(1,24,56,2,2)
	--spr(3,40,56,2,2)
	--spr(5,56,56,2,2)
	--spr(7,72,56,2,2)
	--spr(9,88,56,2,2)
	
	--print("circles... they move",24,72,7)
	
end

