pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
  -- player object
  p = {
    x = 8,   -- pixel x
    y = 8,   -- pixel y
    w = 8,    -- width (change if sprite is smaller/larger)
    h = 8,    -- height
    speed = 1
  }
end

function _update60()
  local dx = 0
  local dy = 0

  -- 1. gather directional input
  if btn(0) then dx -= p.speed end -- left
  if btn(1) then dx += p.speed end -- right
  if btn(2) then dy -= p.speed end -- up
  if btn(3) then dy += p.speed end -- down

  -- 2. move & check x axis
  p.x += dx
  if dx > 0 then
    -- moving right: check top-right and bottom-right corners
    if is_solid(p.x + p.w - 1, p.y) or is_solid(p.x + p.w - 1, p.y + p.h - 1) then
      -- snap to left side of the tile
      p.x = flr((p.x + p.w - 1) / 8) * 8 - p.w
    end
  elseif dx < 0 then
    -- moving left: check top-left and bottom-left corners
    if is_solid(p.x, p.y) or is_solid(p.x, p.y + p.h - 1) then
      -- snap to right side of the tile
      p.x = flr(p.x / 8) * 8 + 8
    end
  end

  -- 3. move & check y axis
  p.y += dy
  if dy > 0 then
    -- moving down: check bottom-left and bottom-right corners
    if is_solid(p.x, p.y + p.h - 1) or is_solid(p.x + p.w - 1, p.y + p.h - 1) then
      -- snap to top side of the tile
      p.y = flr((p.y + p.h - 1) / 8) * 8 - p.h
    end
  elseif dy < 0 then
    -- moving up: check top-left and top-right corners
    if is_solid(p.x, p.y) or is_solid(p.x + p.w - 1, p.y) then
      -- snap to bottom side of the tile
      p.y = flr(p.y / 8) * 8 + 8
    end
  end
end

function _draw()
  cls(1)          -- clear screen with dark blue
  map(0, 0, 0, 0) -- draw your map
  spr(1, p.x, p.y) -- draw player (assumes sprite index 1)
end

-- helper function to check if a pixel coordinate hits a solid tile
function is_solid(px, py)
  -- convert pixel to map tile coordinate
  local tx = flr(px / 8)
  local ty = flr(py / 8)
  
  -- get the sprite number at this tile
  local tile = mget(tx, ty)
  
  -- check if flag 0 (solid) is true
  return fget(tile, 0)
end

