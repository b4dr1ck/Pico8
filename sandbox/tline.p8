pico-8 cartridge // http://www.pico-8.com
version 43
__lua__


local w=48        -- wall ends w pixels in from the screen edge
local cy=64       -- horizon
local h0,h1=64,18 -- half height: near edge, far edge
local mx,my=0,0   -- top-left map cell of the wall texture
local uw,vh=4,3   -- map cells used across / down the wall

-- sx: screen x of the near edge, dir: 1 = wall runs right, -1 = runs left
function sidewall(sx,dir)
 if dir == -1 then
  mx=4
 else
  mx=0
 end
 
	for i=0,w do
		local t=i/w
		local h=h0+(h1-h0)*t
		-- perspective correct u: 1/z is proportional to h
		local u=mx+uw*t*h1/h
		tline(sx+i*dir,cy-h,sx+i*dir,cy+h,u,my,0,vh/(2*h))
	end
end

function _draw()
	cls(0)
	rectfill(0,64,128,128,4)
	sidewall(0,1)
	sidewall(127,-1)
end
