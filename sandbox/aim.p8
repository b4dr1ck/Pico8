pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

-- utils
--  sprite animation function
function anim(tick,img,img_start,img_end,img_spd,img_stop)
	if tick % img_spd == 0 then
		img+=1
	end
	
	if img > img_end then
	 if img_stop then
	 	img=img_end
	 else
			img=img_start
		end
	end
		
	return img	
end


---------------------------------------

function _init()
	ticks=0
	
	player={
	 img=1,
  sprites={
   idle={1,2},
   walk={2,4},
   dead={5,8}
  },
  state="idle",
		x=64,
		y=64,
		spd=1,
		flipx=false,
	}
end

function _update60()
	ticks+=1
 player.state="idle"
 
 -- player movement control
 if (btn(⬅️) and btn(⬆️)) or
			 (btn(⬆️) and btn(➡️)) or
			 (btn(➡️) and btn(⬇️)) or
			 (btn(⬇️) and btn(⬅️)) 
  then
  player.spd=0.707
 else
 	player.spd=1
 end
 
 
 if btn(⬅️) then
 	player.x -= player.spd
 	player.flipx = true
 elseif btn(➡️) then
  	player.x += player.spd
	 	player.flipx = false
 end
 
 if btn(⬆️) then
 	player.y -= player.spd
 elseif btn(⬇️) then
  	player.y += player.spd
 end
	
	-- animations
	if btn(⬆️) or 
				btn(⬇️) or 
				btn(⬅️) or 
				btn(➡️) 
	then
		player.state="walk"			
	end
	
	player.img=anim(
		ticks,
		player.img,
  player.sprites[player.state][1],
  player.sprites[player.state][2],
  10,
  false
  )
 
	-- reset ticks
 if	ticks>=100 then
 	ticks=0
 end

end

function _draw()
	cls()
	
 -- calculate centered position
 local cam_x = player.x - 64
 local cam_y = player.y - 64
 
 -- clamp the camera so it stays within map bounds (0 to 1024 wide, 0 to 512 high)
 -- screen size is 128x128, so max camera positions are (1024-128) and (512-128)
 cam_x = mid(0, cam_x, 888)
 cam_y = mid(0, cam_y, 376)
 
 camera(cam_x, cam_y)
 
 -- draw map
	map(1,1)
	
	-- draw player
	ovalfill(player.x-1,
										player.y+6,
										player.x+7,
										player.y+8,
										1)
	spr(player.img,
					player.x,
					player.y,
					1,
					1,
					player.flipx
					)
					
end
