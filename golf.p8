pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

function _init()
 poke(0x5f2d, 0x1) -- enable mouse

 mousex=0
 mousey=0
 mouseb=0 -- button
 mousebp=0 -- button pressed
 mousebr=0 -- button released
 
 attempts=0
 
 ball=new_ball(1,64,64)	
 obstacles={
	 {x=32,y=40,img=6,w=8,h=8},
	 {x=32,y=56,img=6,w=8,h=8},
 }

 spd=0
 maxspd=8
 angle=0
 
 aimline={
	 visible=false,
	 length=12,
  x1=0,
  y1=0,
  x2=0,
  y2=0,
 }
 
 o_collide_x=false
 o_collide_y=false
 
 mapbounds_x=128
 mapbounds_y=128
end

function _update60()
 cam_x = mid(0, ball.x - 64, mapbounds_x) 
 cam_y = mid(0, ball.y - 64, mapbounds_y)
 
 -- mouse coordinates
 mousex=stat(32)+cam_x
 mousey=stat(33)+cam_y
 mouseb=stat(34)
 
 -- aim and charge power
 if mouseb == 1 then
 	angle = atan2(mousex-ball.x,mousey-ball.y)
 	mouse_angle = atan2(mousex-(ball.x+4),mousey-(ball.y+4))
 	mousebp=1
 	
  ball.xspd = cos(angle) * spd 
  ball.yspd = sin(angle) * spd

	 -- aim line 
		aimline.x1=ball.x+4
		aimline.y1=ball.y+4
		aimline.x2=ball.x+4+cos(mouse_angle)*(spd*2)
		aimline.y2=ball.y+4+sin(mouse_angle)*(spd*2)
	 aimline.visible = true
	 
	 spd=min(maxspd,spd+0.1)
  mousebr=1
 end
 
 -- count attempts
 if mouseb == 0 and  mousebr==1 then
 	attempts+=1
 end

 -- ball moves
 if mouseb == 0 and mousebp == 1 then
  mousebr=0
  aimline.visible = false
  o_collide_x=false
  o_collide_y=false
  spd=max(0,spd-0.1)
  
  ball.xspd = cos(angle) * spd 
  ball.yspd = sin(angle) * spd
   
  -- collisions 
  -- x-axis
		for o in all(obstacles) do
	  if aabb({x=ball.x+ball.xspd,
  								  y=ball.y,
  								  w=8,h=8
  								  },o,2)
   then
   	o_collide_x=true	
   end
  end   

  if collide(ball.x+ball.xspd,ball.y,2,0) or 
  			o_collide_x
 	then
   ball.xspd=-ball.xspd
   angle=0.5-angle
  else
   ball.x+=ball.xspd
  end
  
  -- y-axis
		for o in all(obstacles) do
	  if aabb({x=ball.x,
  								  y=ball.y+ball.yspd,
  								  w=8,h=8
  								  },o,2)
   then
   	o_collide_y=true	
   end
  end  

  if collide(ball.x,ball.y+ball.yspd,2,0) or 
     o_collide_y
  then
   ball.yspd=-ball.yspd
   angle=-angle
  else
   ball.y+=ball.yspd
  end 
 end
 
 -- hole reached
 if collide(ball.x,ball.y,2,1) and
    spd==0
 then
		ball.x = 64
		ball.y = 64 	
		attempts=0
 end
end

function _draw()
 cls()
 camera(cam_x,cam_y)
 
 map(0,0) 
 

 for o in all(obstacles) do
	 spr(o.img,o.x,o.y)
	end
 
 spr(ball.img,ball.x,ball.y)

 if aimline.visible then
	 line(aimline.x1,aimline.y1,aimline.x2,aimline.y2,8)
	end
	
 circfill(mousex,mousey,0,10)
 
 camera()

 print(attempts,0,0,7)
 

 
end

-->8

-- create new ball object
function new_ball(img,x,y)
 return {
  img = img,
  x = x,
  y = y,
  h = 4,
  w = 4,
  xspd=0,
  yspd=0,
 }
end

-- check flag
function has_flag(x,y,flag) 
	if fget(mget(flr(x/8),flr(y/8)),flag) then
		return true
	end
	
	return false
end

-- collision using is_solid (fget)
function collide(x,y,offset,flag) 
 if has_flag(x+offset,y+offset,flag) or
    has_flag(x+7-offset,y+offset,flag) or
    has_flag(x+offset,y+7-offset,flag) or
    has_flag(x+7-offset,y+7-offset,flag) 
 then	
  return true
 end
 return false
end


-- aabb collision
function aabb(obj1,obj2,offset) 
 return(
  obj1.x + offset < obj2.x + obj2.w - offset and
  obj1.x + obj1.w - offset > obj2.x + offset and
  obj1.y + offset < obj2.y + obj2.h - offset and
  obj1.y + obj1.h - offset > obj2.y	+ offset 
 )
end
