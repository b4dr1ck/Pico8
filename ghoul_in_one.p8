-- hud

local function term(strokes,par) 
 -- birdie
 if strokes == par - 1 then
	 return "\^o0ff\fbbirdie"
 end 

 -- bogey
 if strokes == par + 1 then
  return "\^o0ff\f9bogey"
 end
  
 -- double bogey
 if strokes == par + 2 then
  return "\^o0ff\f8dbl 8bogey"
 end 
 
 -- hole failed
 if strokes > par + 3 then
  return "\^o0ff\f8hole failed"
 end 
 
 return ""
end

function result(maps) 
 local result_string=""
 local ind=1
 local score=0
 
 -- create result-string
 for m in all(maps) do
 	result_string = result_string.."\f1"..m.name..": "..
 																	"\f2"..player.strokes[ind].."/"..m.par.."\n"
 	score+=player.strokes[ind]
 	ind+=1
 end
 
 -- score at the end 
 result_string=result_string.."\f0\*a_\ntotal: "..score
 
 return result_string
end


function init_hud()
 bloodstains={}
 x=0
 y=0
end

function update_hud()
 if #bloodstains < 60 then
  x+=randi(5)
  y+=randi(5)
  r=randi(5)
	 add(bloodstains,{x=x,y=y,r=r})
 end
end

function draw_hud()
	camera()
	-- result table
	if player.showresult then
		fillp(0b0101101001011010)
		-- back
	 rectfill(0,0,127,127,0x67)
	 fillp()
	 -- frame
	 rect(0,0,127,127,1)
	 -- bloodstains
	 for b in all(bloodstains) do
	  circfill(b.x,b.y,b.r,8)
	 end
	 
	 -- text
		print("\^o8ff\f7game score:",2,2,7)
		print("\*f_",0,5,1)
		print("\*f_",60,5,1)
		print(result(maps),2,12)
	else
	 print("\^o0ff\f6"..current_level.name,0,0)
	 print("\^o0ff\faSTROKES: \f7" .. player.strokes[player.level].." \faPAR: \f7"..current_level.par,0,121)
	 print(term(player.strokes[player.level],current_level.par),74,121)
 end
end
