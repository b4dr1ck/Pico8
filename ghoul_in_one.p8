__lua__
-- ghoul in one
-- BY BADRICK

function _init()
 init_map()
 init_mouse()
	init_player()
end

function _update60()
 update_mouse()
	update_player()
	update_map()
	update_obst()
end

function _draw()
 cls()
 
 draw_map()
 draw_player()
 draw_obst()
 draw_mouse()
 draw_hud()
end
-->8
-- player

function init_player()
	poke(0x5f34,0x2) -- inverted draw operations
	
	ticks=0
	
 player={
 	img=1,
 	x=maps[1].spawn[1]*8,
 	y=maps[1].spawn[2]*8,
 	xspd=0,
 	yspd=0,
 	moving=false,
 	angle=0,
 	maxspd=8,
 	spd=0,
 	w=4,
 	h=6,
 	strokes={0,0,0,0,0,0},
 	level=1,
 	restart=false,
 }
 
 aimline={
  visible=false,
  length=14,
  c=7,
  x1=0,y1=0,x2=2,y2=0,
 }
 
 spot_radius=200
 spot=false
 
 arrow={x=player.x,
 							y=0,
 							visible=true
 							}
 
 slime={}
 playsfx=true
end


function update_player()
 -- ticks-counter (frames)
	ticks+=1
	if ticks > 1000 then
	 ticks=0
	end
	
 -- holding left mouseb (1)
 if mouse.b == 1 and
    not player.moving and
    not spot
 then
 	mouse.br = 1
 	   
 	if playsfx then
 	 playsfx=false
   sfx(0)
 	end
 	
  -- set player speed and angle
 	player.angle = atan2(mouse.x - (player.x + 4), mouse.y - (player.y + 4))	 	
 	player.spd=min(player.maxspd, player.spd + 0.05)
 	
 	player.xspd = cos(player.angle) * player.spd
 	player.yspd = sin(player.angle) * player.spd
 	 	
 	-- aim line 
		aimline.x1=player.x+4
		aimline.y1=player.y+4
		aimline.x2=player.x+4+cos(player.angle)*(aimline.length)
		aimline.y2=player.y+4+sin(player.angle)*(aimline.length)
	 aimline.visible = true 	
 end   
 
 -- on mouse release
 if mouse.b == 0 and
    mouse.br == 1
 then
  player.strokes[player.level] += 1
  player.moving = true
  mouse.br = 0
  playsfx=true
  sfx(-1)
  sfx(1)
 end
 
 -- player movement
 if player.moving then
  aimline.visible = false
  arrow.visible = false
  
  local obst_x_collide=false
  local obst_y_collide=false
 
  -- decrease speed
  player.spd=max(0,player.spd-0.1)

  player.xspd = cos(player.angle) * player.spd
  player.yspd = sin(player.angle) * player.spd
  
  -- obstacles on x-axis
  local obstacles=maps[player.level].obstacles
  for o in all(obstacles) do
   if aabb(
   							{x=player.x+player.xspd,
   							 y=player.y,w=8,h=8},
   							 o,
   							 2) 
   then
   	obst_x_collide=true
   end
  end
    
  -- tile on x-axis
  if tile_collision(player.x + player.xspd, player.y,0,0) or
     obst_x_collide
  then
  	player.xspd = -player.xspd
  	player.angle=0.5 - player.angle
  	sfx(2)
  else
  	player.x+=player.xspd
  end
  
  -- obstacles on x-axis
  for o in all(obstacles) do
   if aabb(
   							{x=player.x,
   							 y=player.y+player.yspd,w=8,h=8},
   							 o,
   							 2) 
   then
   	obst_y_collide=true
   end
  end

 -- tile y-axis
  if tile_collision(player.x, player.y + player.yspd,0,0) or
     obst_y_collide
  then
  	player.yspd = -player.yspd
  	player.angle = -player.angle
  	sfx(2)
  else
   player.y+=player.yspd
  end
  
		-- creat slime
		local slimex=player.x+4+randbi(-3,3)
		local slimey=player.y+4+randbi(-3,3)
		
		if	not tile_collision(slimex,slimey,0,1)
		then
	  add(slime,{x=slimex,y=slimey,ttl=600,r=randi(2)})
	 end
  
  -- player not moving
  if player.spd == 0 then
   player.moving = false
   arrow.visible = true
   arrow.x = player.x
   arrow.y = 0
   -- level transition
   if tile_collision(player.x,player.y,2,1) then
	  	spot=true
	  	arrow.visible=false
 	  sfx(3)
   end
   -- player reset
   if tile_collision(player.x,player.y,2,3) then
	  	spot=true
	  	arrow.visible=false
	  	player.restart=true
 	  sfx(5)
   end
  end 
 end
 
 -- spot
 if spot then
  spot_radius-=3
  if spot_radius <= 0 then
  
    if not player.restart then
	    player.level += 1 
	   else
    	player.restart=false
	   end
	   
		  if player.level > #maps then
		   player.level = 1
		  end
		  
		  arrow.visible=true
    player.x=maps[player.level].spawn[1]*8
    player.y=maps[player.level].spawn[2]*8
    player.img=1
		  arrow.x	= player.x

    spot=false
    spot_radius=200
  end
 end
 
 -- arrow update
 if arrow.visible then
	 arrow.y = player.y + sine_wave(arrow.x,4,0.05) - 10
	end

 -- update slime
 for s in all(slime) do
  s.ttl -= 1
  if s.ttl <= 0 then
   del(slime,s)
  end
 end
  
 -- animation
 if player.moving then
  player.img=animate(player.img,1,4,0.1,true)
 end
end


function draw_player()
 -- slime
 fillp(0b1010010110100101)
 for s in all(slime) do
  circfill(s.x,s.y,s.r,0xba)
 end
 fillp()

 -- player (ball)
 ovalfill(player.x-2,player.y+4,player.x+4,player.y+7,1)
 spr(player.img,player.x,player.y)

 -- arrow
 if arrow.visible then
  --print("\^o7ff\f1⬇️",arrow.x,arrow.y,12)
  spr(18,arrow.x,arrow.y)
 end
 
 -- aimline
 if aimline.visible then
   -- charge bar
   rectfill(player.x-1,player.y-5,player.x + 9 , player.y - 3, 0)
   line(player.x,player.y-4,flr(player.x+player.spd),player.y-4,8)

   -- aimline itself
 	 line(aimline.x1,aimline.y1,aimline.x2,aimline.y2,aimline.c)
 end
 
 -- spot
	circfill(player.x+4,player.y+4,spot_radius,0x1800)

 -- debug
--   print(#maps[player.level].obstacles,64,0,7)
-- print(player.strokes)
-- print(player.spd)
end
-->8
-- mouse
function init_mouse()
 poke(0x5f2d,0x1)
 mouse={
  b=0,
  bp=0,
  br=0,
  x=0,
  y=0,
 }
end

function update_mouse()
 mouse.x=stat(32) + cam_x
 mouse.y=stat(33) + cam_y
 mouse.b=stat(34)
end

function draw_mouse()
 if not aimline.visible then
	 circfill(mouse.x,mouse.y,0,7)
	end
end
