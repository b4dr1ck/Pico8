-- maps

function init_map()
 cam_x=0
 cam_y=0
 maps={
  {
  	name="simple enough?",
  	par=3,
  	x=0,
  	y=0,
  	sizex=0,
  	sizey=0,
  	spawn={2,13},
  	hole={13,2},
  	obstacles={
--  		{x=80,y=80,xspd=0.25,yspd=0,w=8,h=8,img=5},
--  		{x=60,y=80,xspd=0,yspd=0.25,w=8,h=8,img=5}
  	}
  },
  {
  	name="stones on my way",
  	par=3,
  	x=1,
  	y=0,
  	sizex=0,
  	sizey=0,
  	spawn={18,13},
  	hole={23,6},
  	obstacles={}
  },
  {
  	name="two walls",
  	par=3,
  	x=2,
  	y=0,
  	sizex=0,
  	sizey=0,
  	spawn={34,13},
  	hole={34,3},
  	obstacles={}
  },
  {
  	name="larger one",
  	par=3,
  	x=3,
  	y=0,
  	sizex=1,
  	sizey=0,
  	spawn={50,13},
  	hole={75,8},
  	obstacles={
	  	{x=552,y=56,xspd=0,yspd=0.25,w=8,h=8,img=5}
  	}
  }
 }
	current_level=maps[1]
	flag={
		img=16,
		w=8,h=8,
		x=current_level.hole[1] * 8,
		y=current_level.hole[2] * 8-4}
end

function update_map()
 current_level=maps[player.level]
 cam_x = mid(current_level.x*128, player.x - 64, current_level.x*128+(128*current_level.sizex)) 
 cam_y = mid(current_level.y*128, player.y - 64, current_level.y*128+(128*current_level.sizey))
 
 -- update flag position 
	flag.x=current_level.hole[1] * 8
	flag.y=current_level.hole[2] * 8-4
 flag.img=animate(flag.img,16,17,0.05,true)
end

function draw_map()
 camera(cam_x,cam_y)

 pal(3,131,1)
 -- draw map
 map(0,0)
 -- spawnpoint
 mset(current_level.spawn[1],
					 current_level.spawn[2],
					 67
					 )
	-- hole
 mset(maps[player.level].hole[1],
				 maps[player.level].hole[2],
				 66
				 )
	-- draw flag
	if aabb(player,flag,0) then
		spr(flag.img,flag.x,flag.y-8)
	else
		spr(flag.img,flag.x,flag.y)
	end

end
-->8
-- hud

local function term(strokes,par) 
 -- birdie
 if strokes == par - 1 then
	 return "\^o0ff\fbbirdie"
 end 

 -- bogey
 if strokes == par + 1 then
  return "\^o0ff\f9bogey"
 end
  
 -- double bogey
 if strokes == par + 2 then
  return "\^o0ff\f8dbl 8bogey"
 end 
 
 -- hole failed
 if strokes > 6 then
  return "\^o0ff\f8hole failed"
 end 
 
 return ""
end


function init_hud()
end

function update_hud()
end

function draw_hud()
	camera()
 print("\^o0ff\f6"..current_level.name,0,0)
 print("\^o0ff\faSTROKES: \f7" .. player.strokes[player.level].." \faPAR: \f7"..current_level.par,0,121)
end
-->8
-- obstacles

function init_obst()
end

function update_obst()
 local obstacles=maps[player.level].obstacles
 for o in all(obstacles) do
  o.x+=o.xspd
  o.y+=o.yspd
  
  -- tile collision (change direction)
  if tile_collision(o.x,o.y,0,0) then
   if o.xspd > 0 or o.xspd < 0 then
    o.xspd *= -1
   end
   if o.yspd > 0 or o.yspd < 0 then
    o.yspd *= -1
   end
  end
  
  -- on player collision - move player
  if aabb(o,player,0) then
   if o.xspd > 0 then
    player.x-=1
    arrow.x-=1
   end
   if o.xspd < 0 then
    player.x+=1
    arrow.x+=1
   end
   if o.yspd > 0 then
    player.y-=1
    arrow.y-=1
   end
   if o.yspd < 0 then
    player.y+=1
    arrow.y+=1
   end
  end
 end
end

function draw_obst()
 local obstacles=maps[player.level].obstacles
 for o in all(obstacles) do
  spr(o.img,o.x,o.y)
 end
end
