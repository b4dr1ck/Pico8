pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- ghoul in one
-- BY BADRICK

function _init()
 init_map()
 init_mouse()
	init_player()
end

function _update60()
 update_mouse()
	update_player()
	update_map()
end

function _draw()
 cls()
 
 draw_map()
 draw_player()
 draw_mouse()
 draw_hud()
end
-->8
-- player

function init_player()
	poke(0x5f34,0x2) -- inverted draw operations
	
	ticks=0
	
 player={
 	img=1,
 	x=maps[1].spawn[1]*8,
 	y=maps[1].spawn[2]*8,
 	xspd=0,
 	yspd=0,
 	moving=false,
 	angle=0,
 	maxspd=8,
 	spd=0,
 	w=4,
 	h=6,
 	strokes={0,0,0,0,0,0},
 	level=1,
 }
 
 aimline={
  visible=false,
  length=12,
  c=7,
  x1=0,y1=0,x2=2,y2=0,
 }
 
 spot_radius=200
 spot=false
 
 arrow={x=player.x,
 							y=0,
 							visible=true
 							}
 
 slime={}
end


function update_player()
 -- ticks-counter (frames)
	ticks+=1
	if ticks > 1000 then
	 ticks=0
	end
	
 -- cancel charge on right-click
 if mouse.b == 3 and
    not player.moving
 then
  player.spd = 0
  aimline.visible = false
 end

 -- holding left mouseb (1)
 if mouse.b == 1 and
    not player.moving and
    not spot
 then
 	mouse.br = 1
   
  -- set player speed and angle
 	player.angle = atan2(mouse.x - (player.x + 4), mouse.y - (player.y + 4))	 	
 	player.spd=min(player.maxspd, player.spd + 0.05)
 	
 	player.xspd = cos(player.angle) * player.spd
 	player.yspd = sin(player.angle) * player.spd
 	 	
 	-- aim line 
		aimline.x1=player.x+4
		aimline.y1=player.y+4
		aimline.x2=player.x+4+cos(player.angle)*(aimline.length)
		aimline.y2=player.y+4+sin(player.angle)*(aimline.length)
	 aimline.visible = true 	
 end   
 
 -- on mouse release
 if mouse.b == 0 and
    mouse.br == 1 
 then
  player.strokes[player.level] += 1
  player.moving = true
  mouse.br = 0
 end
 
 -- player movement
 if player.moving then
  aimline.visible = false
  arrow.visible = false
 
  -- decrease speed
  player.spd=max(0,player.spd-0.1)
  
  player.xspd = cos(player.angle) * player.spd
  player.yspd = sin(player.angle) * player.spd
  
  -- collisions
  -- x-axis
  if tile_collision(player.x + player.xspd, player.y,0,0) 
  then
  	player.xspd = -player.xspd
  	player.angle=0.5 - player.angle
  else
  	player.x+=player.xspd
  end

 -- y-axis
  if tile_collision(player.x, player.y + player.yspd,0,0) 
  then
  	player.yspd = -player.yspd
  	player.angle = -player.angle
  else
   player.y+=player.yspd
  end
  
		-- creat slime
		local slimex=player.x+4+randbi(-3,3)
		local slimey=player.y+4+randbi(-3,3)
		
		if	not tile_collision(slimex,slimey,0,1)
		then
	  add(slime,{x=slimex,y=slimey,ttl=600,r=randi(2)})
	 end
  
  -- player not moving
  if player.spd == 0 then
   player.moving = false
   arrow.visible = true
   arrow.x = player.x
   arrow.y = 0
   -- level transition
   if tile_collision(player.x,player.y,2,1) then
	  	spot=true
	  	arrow.visible=false
   end
  end 
 end
 
 -- spot
 if spot then
  spot_radius-=3
  if spot_radius <= 0 then
    player.level += 1 
		  if player.level > #maps then
		   player.level = 1
		  end
		  arrow.visible=true
    player.x=maps[player.level].spawn[1]*8
    player.y=maps[player.level].spawn[2]*8
		  arrow.x	= player.x
    spot=false
    spot_radius=200
  end
 end
 
 -- arrow update
 if arrow.visible then
	 arrow.y = player.y + sine_wave(arrow.x,4,0.05) - 10
	end

 -- update slime
 for s in all(slime) do
  s.ttl -= 1
  if s.ttl <= 0 then
   del(slime,s)
  end
 end
  
 -- animation
 if player.moving then
  player.img=animate(player.img,1,4,0.1,true)
 end
end


function draw_player()
 -- slime
 fillp(0b1010010110100101)
 for s in all(slime) do
  circfill(s.x,s.y,s.r,0xba)
 end
 fillp()

 -- player (ball)
 ovalfill(player.x-2,player.y+4,player.x+4,player.y+7,1)
 spr(player.img,player.x,player.y)

 -- arrow
 if arrow.visible then
  --print("\^o7ff\f1⬇️",arrow.x,arrow.y,12)
  spr(18,arrow.x,arrow.y)
 end
 
 -- aimline
 if aimline.visible then
   -- charge bar
   rectfill(player.x-1,player.y-5,player.x + 9 , player.y - 3, 0)
   line(player.x,player.y-4,flr(player.x+player.spd),player.y-4,8)

   -- aimline itself
 	 line(aimline.x1,aimline.y1,aimline.x2,aimline.y2,aimline.c)
 end
 
 -- spot
	circfill(player.x+4,player.y+4,spot_radius,0x1800)

 -- debug
 print(#slime,64,0)
-- print(player.strokes)
-- print(player.spd)
end
-->8
-- mouse
function init_mouse()
 poke(0x5f2d,0x1)
 mouse={
  b=0,
  bp=0,
  br=0,
  x=0,
  y=0,
 }
end

function update_mouse()
 mouse.x=stat(32) + cam_x
 mouse.y=stat(33) + cam_y
 mouse.b=stat(34)
end

function draw_mouse()
 if not aimline.visible then
	 circfill(mouse.x,mouse.y,0,7)
	end
end
-->8
-- maps

function init_map()
 cam_x=0
 cam_y=0
 maps={
  {
  	name="simple enough?",
  	par=3,
  	x=0,
  	y=0,
  	size=1,
  	spawn={2,13},
  	hole={13,2},
  },
  {
  	name="stones on my way",
  	par=3,
  	x=1,
  	y=0,
  	size=1,
  	spawn={18,13},
  	hole={23,6},
  },
  {
  	name="two walls",
  	par=3,
  	x=2,
  	y=0,
  	size=1,
  	spawn={34,13},
  	hole={34,3},
  }
 }
	current_level=maps[1]
	flag={
		img=16,
		w=8,h=8,
		x=current_level.hole[1] * 8,
		y=current_level.hole[2] * 8-4}
end

function update_map()
 current_level=maps[player.level]
 cam_x = mid(current_level.x*128, player.x - 64, current_level.x*128) 
 cam_y = mid(current_level.y*128, player.y - 64, current_level.y*128)
 
 -- update flag position 
	flag.x=current_level.hole[1] * 8
	flag.y=current_level.hole[2] * 8-4
 flag.img=animate(flag.img,16,17,0.05,true)
end

function draw_map()
 camera(cam_x,cam_y)

 pal(3,131,1)
 -- draw map
 map(0,0)
 -- spawnpoint
 mset(current_level.spawn[1],
					 current_level.spawn[2],
					 67
					 )
	-- hole
 mset(maps[player.level].hole[1],
				 maps[player.level].hole[2],
				 66
				 )
	-- draw flag
	if aabb(player,flag,0) then
		spr(flag.img,flag.x,flag.y-8)
	else
		spr(flag.img,flag.x,flag.y)
	end

end
-->8
-- hud

local function term(strokes,par) 
 -- birdie
 if strokes == par - 1 then
	 return "\^o0ff\fbbirdie"
 end 

 -- bogey
 if strokes == par + 1 then
  return "\^o0ff\f9bogey"
 end
  
 -- double bogey
 if strokes == par + 2 then
  return "\^o0ff\f8dbl 8bogey"
 end 
 
 -- hole failed
 if strokes > 6 then
  return "\^o0ff\f8hole failed"
 end 
 
 return ""
end


function init_hud()
end

function update_hud()
end

function draw_hud()
	camera()
 print("\^o0ff\f6"..current_level.name,0,0)
 print("\^o0ff\faSTROKES: \f7" .. player.strokes[player.level].." \faPAR: \f7"..current_level.par,0,121)
 
 print(term(player.strokes[player.level],current_level.par),74,121)
end
-->8
-- utils

------------------------------
-- sprite animations
function animate(img,first,last,spd,loop)
 if img < last + 1 - spd then
  img+=spd
  
  if not loop then
   return last 
  end
  
 else
   img = first
 end
 
 return img
end

------------------------------
-- tile collision 
function tile_collision(x,y,offset,flag) 
 if has_flag(x+offset,y+offset,flag) or
    has_flag(x+7-offset,y+offset,flag) or
    has_flag(x+offset,y+7-offset,flag) or
    has_flag(x+7-offset,y+7-offset,flag) 
 then	
  return true
 end
 return false
end

function has_flag(x,y,flag) 
	if fget(mget(flr(x/8),flr(y/8)),flag) then
		return true
	end
	
	return false
end 

-- aabb collisison
function aabb(obj1,obj2,offset) 
 return(
  obj1.x + offset < obj2.x + obj2.w - offset and
  obj1.x + obj1.w - offset > obj2.x + offset and
  obj1.y + offset < obj2.y + obj2.h - offset and
  obj1.y + obj1.h - offset > obj2.y	+ offset 
 )
end

------------------------------
-- sine wave
function sine_wave(x,amp,frq)
	 local amplitude = amp
	 local frequency = frq
	 local speed = time() * 2
	 
	 return sin((x * frequency) + speed) * amplitude
end

------------------------------
-- random
function randi(v)
	return flr(rnd(v+1))
end

function randbi(f,t) 
	return flr(rnd(t+1-f))+f
end

