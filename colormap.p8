function _update()

end

function _draw()
	cls(1)
	
	local rows=split(image,"\n",false)
 for y,r in pairs(rows) do
	 y-=1
 	local columns=split(r,"",false) 
 	for x,c in pairs(columns) do
 	 if c != "" then
	 	 x-=1
	   rectfill(
	   	x,
	   	y,
	   	x+1,
	   	y+1,
	   	"0x"..c
	   )
	  end
 	end
 end
end
