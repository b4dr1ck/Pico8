-- hud
function init_hud()
 aim_cursor={
  active=false,
  x=player.x,
  y=player.y+8,
  img=1,
  speed=1,
 }
 
 fishing_options={
  active=false,
  bait={},
  hook={},
  rod={}
 }
 
end

function update_hud()
 --* aim cursor
 --** toggle aim cursor
 if btnp(🅾️) and 
 			not bobber.active
 then
 	aim_cursor.active = not aim_cursor.active
 	aim_cursor.x=player.x
 	aim_cursor.y=player.y+8
 end
 
 --** toggle options menu
 if btnp(❎) and
			 not bobber.active and
    not player.charging and
			 not aim_cursor.active
	then
		fishing_options.active=not fishing_options.active		  	
 end
end

function draw_hud()
 --* aim cursor
 if aim_cursor.active then
  spr(aim_cursor.img,aim_cursor.x,aim_cursor.y)
 end
 
	--** fishing options
	if fishing_options.active then
	 local xoffset=0
	 if player.x > 100+camx then
	 	xoffset=-100 
	 end
 	rectfill(100+camx+xoffset,0+camy,127+camx+xoffset,127+camy,5)
 	rect(100+camx+xoffset,0+camy,128+camx+xoffset,128+camy,6)
	end

 --* help
 if not aim_cursor.active and 
 			not player.charging and
 			not bobber.active
 then
	 print("\f0⬅️➡️⬆️⬇️\f1 TO MOVE\n"..
	 						"\f0❎\f1 FISHING OPTIONS\n"..
	 						"\f0🅾️ \f1 TOGGLE CURSOR",
	 						2+camx,108+camy,1)
 elseif aim_cursor.active and 
 							not player.charging and
 							not bobber.active
 then
	 print("\f0⬅️➡️⬆️⬇️\f1 MOVE CURSOR\n"..
 	      "\f0❎\f1 TO CAST",
 	      2+camx,114+camy,1)
	elseif player.charging then
 	print("HOLD ❎",2+camx,120+camy,1)
 elseif bobber.active and bobber.state == "idle" then
 	print("🅾️ TO RESET",2+camx,120+camy,1)
	end
end
